### .env.staging.sample
###
### Environment variables for the staging environment (the staging branch
### deploy, staging--north-foster-farm.netlify.app).
###
### !!! Secret values are left blank in the .sample. Keep the filled-in
### !!! .env.staging in your password manager and the project root only.
###
### To set up environment: use this file to set up the environment on Netlify
### (bin/nff env push --staging).

## Site
##
## Which deploy this is, and the address links in emails point at. Set per
## Netlify deploy context.

# SITE_CONTEXT
# Which deploy this is. Picks the Blobs store names (production uses the bare
# names) and turns staging behaviour on or off. bin/nff sets it from its flag.
SITE_CONTEXT=branch-deploy

# SITE_URL
# The site's own address. Links in emails start with it, and Square signs its
# webhooks against it.
SITE_URL=https://staging--north-foster-farm.netlify.app

# ACCOUNTS_ENABLED
# true puts account links (sign in, your orders) in emails.
ACCOUNTS_ENABLED=true

# MAINTENANCE_SECRET
# Signs the phone links that flip maintenance mode. Any long random string, a
# different one per context. Without it only bin/nff maintenance on|off can flip
# the switch.
MAINTENANCE_SECRET=

## Square
##
## Card, Apple Pay, Google Pay and Cash App Pay. Log in at
## developer.squareup.com/apps. Each environment has its own application:
## Credentials holds the IDs and token, Webhooks > Subscriptions the signature
## key. Development uses the fake driver.

# SQUARE_ENV
# Which Square to talk to: production, sandbox, or fake (no network, development
# and tests).
SQUARE_ENV=sandbox

# SQUARE_APPLICATION_ID
# The application ID. Public: the order page's payment form uses it.
# Public: not a secret. Its value is in the env file.
SQUARE_APPLICATION_ID=

# SQUARE_LOCATION_ID
# The Square location the website's sales belong to.
# Public: not a secret. Its value is in the env file.
SQUARE_LOCATION_ID=

# SQUARE_ACCESS_TOKEN
# The application's access token (Credentials > Show). Replacing it switches the
# old one off at once.
SQUARE_ACCESS_TOKEN=

# SQUARE_WEBHOOK_SIGNATURE_KEY
# Checks that webhook calls really come from Square (Webhooks > Subscriptions >
# the subscription > Signature Key).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_SIGNATURE_KEY_PREVIOUS=

## PayPal (Venmo)
##
## Venmo through PayPal. Log in at developer.paypal.com/dashboard, Apps &
## Credentials (Sandbox or Live toggle). Each environment has its own app; the
## webhook ID is listed under the app's webhooks. Development uses the fake
## driver.

# PAYPAL_ENV
# Which PayPal to talk to: live, sandbox, or fake (development and tests).
PAYPAL_ENV=sandbox

# PAYPAL_CLIENT_ID
# The app's Client ID. Public: the Venmo button uses it.
# Public: not a secret. Its value is in the env file.
PAYPAL_CLIENT_ID=

# PAYPAL_CLIENT_SECRET
# The app's Secret.
PAYPAL_CLIENT_SECRET=

# PAYPAL_WEBHOOK_ID
# The webhook's ID, which PayPal needs to check each webhook call. Shown in the
# app's webhook list.
# Public: not a secret. Its value is in the env file.
PAYPAL_WEBHOOK_ID=

# VENMO_HIDDEN
# 1 shows Venmo as Coming soon, except to a browser that opened the order page
# with ?venmo. Empty or 0 shows it.
# Public: not a secret. Its value is in the env file.
VENMO_HIDDEN=

## Mail
##
## How email leaves the site: resend in production, the outbox on staging (read
## it in the browser), files on disk in development.

# MAIL_DRIVER
# resend sends for real; outbox keeps mail in the site's store to read in the
# browser; file writes each email to MAIL_OUT.
MAIL_DRIVER=outbox

# MAIL_FROM
# The sender name and address.
MAIL_FROM="[STAGING] North Foster Farm <orders@mail.northfosterfarm.com>"

# MAIL_REPLY_TO
# Where customers' replies go.
MAIL_REPLY_TO=orders@northfosterfarm.com

# ADMIN_EMAILS
# Who gets the farm's notices, alerts and the morning report; comma-separated.
# Public: not a secret. Its value is in the env file.
ADMIN_EMAILS=

# DEV_NOTIFICATIONS_EMAIL
# The developer's notices (incidents, rotations, failed jobs, rejected
# webhooks), apart from the farm's. Comma-separated. Unset, they go to
# ADMIN_EMAILS.
DEV_NOTIFICATIONS_EMAIL=dev@northfosterfarm.com

## Logs and alerts
##
## Axiom keeps the log lines (app.axiom.co, Settings > API tokens, ingest-only
## tokens, one dataset per environment). Healthchecks pages James's phone
## (healthchecks.io; each check's ping URL is on its page). Not used in
## development.

# AXIOM_TOKEN
# Ingest-only token for this environment's dataset; expires Jan 1.
AXIOM_TOKEN=

# AXIOM_DATASET
# The dataset log lines go to.
AXIOM_DATASET=nff-site-staging

# HEALTHCHECKS_JOBS_URL
# Ping URL of the jobs heartbeat check.
HEALTHCHECKS_JOBS_URL=

# HEALTHCHECKS_ALERT_URL
# Ping URL of the alerts check; alerts post to its /fail.
HEALTHCHECKS_ALERT_URL=

## Staging tools
##
## Guards the staging back office (/api/staging) and lets the browser tests
## read the outbox. Also stored as the GitHub Actions secret STAGING_TOKEN.

# STAGING_TOKEN
# A long random value. Also the GitHub Actions secret of the same name.
STAGING_TOKEN=

# E2E_STAGING_TOKEN
# The end-to-end suite's own token. It opens /api/staging/e2e and skips the
# order limit, and nothing else.
E2E_STAGING_TOKEN=

## Local tools
##
## Read only by bin/nff and the browser tests on James's Mac. Never set on
## Netlify. The Netlify token is a personal access token
## (app.netlify.com/user/applications), expiring each Jan 1.

# PICKUP_SCHEDULE_HOOK
# A staging build hook. bin/nff schedule set starts a deploy with it after
# setting the schedule.
# Local only: bin/nff reads it. env push skips it; never set on Netlify.
PICKUP_SCHEDULE_HOOK=

# NETLIFY_SITE_ID
# The Project ID, so bin/nff can reach this site's records.
# Local only: bin/nff reads it. env push skips it; never set on Netlify.
NETLIFY_SITE_ID=

# NETLIFY_AUTH_TOKEN
# James's personal access token; expires Jan 1. The same token sits in both
# local files: it's personal, not a site secret.
# Local only: bin/nff reads it. env push skips it; never set on Netlify.
NETLIFY_AUTH_TOKEN=
