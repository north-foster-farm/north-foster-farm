### .env.staging.sample
###
### A fixture for test/env.test.mjs, in the layout of James's launch
### guide. Every value here is made up.
###
### To set up environment: use this file to set up the environment on Netlify
### (bin/nff env push --staging).

## Site
##
## Which deploy this is, and the address links in emails point at. Set per
## Netlify deploy context.

# SITE_CONTEXT
# Which deploy this is.
SITE_CONTEXT=branch-deploy

# SITE_URL
# The site's own address.
SITE_URL=https://staging.example.test

## Square
##
## Log in at developer.example.test/apps. Credentials holds the IDs and token.

# SQUARE_ACCESS_TOKEN
# The token the functions charge with. A secret: empty here.
SQUARE_ACCESS_TOKEN=

# SQUARE_LOCATION_ID
# The Square location the website's sales belong to.
SQUARE_LOCATION_ID=FAKELOCATION

## PayPal (Venmo)
##
## Log in at developer.example.test/dashboard.

# VENMO_HIDDEN
# 1 holds the Venmo button back.
VENMO_HIDDEN=1

## Mail
##
## How email leaves the site.

# MAIL_FROM
# The sender.
MAIL_FROM="[STAGING] North Foster Farm <farm@example.test>"

# MAIL_REPLY_TO
# Where replies go; a quote and a backslash, escaped.
MAIL_REPLY_TO="\"Farm\" \\ <reply@example.test>"

## Local tools
##
## Read only by bin/nff on James's Mac. Never set on Netlify.

# NETLIFY_AUTH_TOKEN
# A personal access token.
# Local only: bin/nff reads it. env push skips it; never set on Netlify.
NETLIFY_AUTH_TOKEN=
