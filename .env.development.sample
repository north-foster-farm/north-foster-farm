### .env.development.sample
###
### Environment variables for the development and test environments.
###
### !!! This file should not contain secrets, or values used in any production
### !!! or staging environment!
###
### To set up environment: copy this file to .env in the root of the project.

## Site
##
## Which deploy this is, and the address links in emails point at. Set per
## Netlify deploy context.

# SITE_CONTEXT
# Which deploy this is. Picks the Blobs store names (production uses the bare
# names) and turns staging behaviour on or off. bin/nff sets it from its flag.
SITE_CONTEXT=dev

# SITE_URL
# The site's own address. Links in emails start with it, and Square signs its
# webhooks against it.
SITE_URL=http://localhost:8888

# ACCOUNTS_ENABLED
# true puts account links (sign in, your orders) in emails.
ACCOUNTS_ENABLED=true

# MAINTENANCE_SECRET
# Signs the phone links that flip maintenance mode. Any long random string, a
# different one per context. Without it only bin/nff maintenance on|off can flip
# the switch.
MAINTENANCE_SECRET=dev-maintenance-secret

## Square
##
## Card, Apple Pay, Google Pay and Cash App Pay. Log in at
## developer.squareup.com/apps. Each environment has its own application:
## Credentials holds the IDs and token, Webhooks > Subscriptions the signature
## key. Development uses the fake driver.

# SQUARE_ENV
# Which Square to talk to: production, sandbox, or fake (no network, development
# and tests).
SQUARE_ENV=fake

# SQUARE_APPLICATION_ID
# The application ID. Public: the order page's payment form uses it.
SQUARE_APPLICATION_ID=sandbox-sq0idb-fake-application-id

# SQUARE_LOCATION_ID
# The Square location the website's sales belong to.
SQUARE_LOCATION_ID=FAKELOCATION

# SQUARE_ACCESS_TOKEN
# The application's access token (Credentials > Show). Replacing it switches the
# old one off at once.
SQUARE_ACCESS_TOKEN=fake-square-access-token

# SQUARE_WEBHOOK_SIGNATURE_KEY
# Checks that webhook calls really come from Square (Webhooks > Subscriptions >
# the subscription > Signature Key).
SQUARE_WEBHOOK_SIGNATURE_KEY=fake-square-signature-key

# SQUARE_WEBHOOK_SIGNATURE_KEY_PREVIOUS
# The old signature key, set only while swapping keys: a delivery signed with
# either key is accepted. Optional: empty outside a swap.
SQUARE_WEBHOOK_SIGNATURE_KEY_PREVIOUS=

# STOCK_OVERRIDES
# James's hand-testing override, normally unset: a few SKUs pinned to a
# count, SKU:n comma-separated (a tier at 1, a sold-out item). Each one listed
# wins over every source; the rest read as usual. No test uses it: each pins
# its own counts for its own requests (#507).
# Optional: empty pins nothing.
# Public: not a secret.
STOCK_OVERRIDES=

## PayPal (Venmo)
##
## Venmo through PayPal. Log in at developer.paypal.com/dashboard, Apps &
## Credentials (Sandbox or Live toggle). Each environment has its own app; the
## webhook ID is listed under the app's webhooks. Development uses the fake
## driver.

# PAYPAL_ENV
# Which PayPal to talk to: live, sandbox, or fake (development and tests).
PAYPAL_ENV=fake

# PAYPAL_CLIENT_ID
# The app's Client ID. Public: the Venmo button uses it.
PAYPAL_CLIENT_ID=fake-paypal-client-id

# PAYPAL_CLIENT_SECRET
# The app's Secret.
PAYPAL_CLIENT_SECRET=fake-paypal-client-secret

# PAYPAL_WEBHOOK_ID
# The webhook's ID, which PayPal needs to check each webhook call. Shown in the
# app's webhook list.
PAYPAL_WEBHOOK_ID=FAKEWEBHOOKID

## Mail
##
## How email leaves the site: resend in production, the outbox on staging (read
## it in the browser), files on disk in development.

# MAIL_DRIVER
# resend sends for real; outbox keeps mail in the site's store to read in the
# browser; file writes each email to MAIL_OUT.
MAIL_DRIVER=file

# MAIL_OUT
# The folder the file driver writes to.
MAIL_OUT=.ignored/outbox

# MAIL_FROM
# The sender name and address.
MAIL_FROM="North Foster Farm <orders@mail.northfosterfarm.com>"

# MAIL_REPLY_TO
# Where customers' replies go.
MAIL_REPLY_TO=orders@northfosterfarm.com

# FARM_NOTIFICATIONS_EMAIL
# The farm's notices: each new order, contact messages, the daily reports;
# comma-separated.
FARM_NOTIFICATIONS_EMAIL=farm@example.com

# DEV_NOTIFICATIONS_EMAIL
# The developer's notices: every alert, rotations, security. Comma-separated.
# No fallback: unset, nobody is told.
DEV_NOTIFICATIONS_EMAIL=dev@example.com

# ESCALATED_NOTIFICATIONS_EMAIL
# One emergency only: orders not recorded, unacknowledged for an hour. Nothing
# else is ever sent here.
ESCALATED_NOTIFICATIONS_EMAIL=escalated@example.com

## Resend
##
## Sends transactional email and keeps the farm-news contacts. Log in at
## resend.com/login. Keys are made at resend.com/api-keys and shown once;
## webhooks at resend.com/webhooks. Production and staging are separate teams,
## if staging has one at all. Simulated in development.

# RESEND_API_KEY
# The sending key: Sending access, limited to the mail domain.
RESEND_API_KEY=re_fake_sending_key

# RESEND_WEBHOOK_SECRET
# Checks that webhook calls (unsubscribes) really come from Resend: the
# webhook's Signing Secret.
RESEND_WEBHOOK_SECRET=whsec_ZmFrZWZha2VmYWtlZmFrZWZha2VmYWtlZmFrZQ==

## Staging tools
##
## Staging is behind an access gate; development has none, and the gate's keys
## stay empty here.

# STAGING_TOKEN
# For machines only. A long random value. Also the GitHub Actions secret of
# the same name.
STAGING_TOKEN=dev-staging-token

# GATE_RESEND_KEY
# Staging's only. Optional: development leaves it empty.
GATE_RESEND_KEY=

# GATE_MAIL_FROM
# Staging's only. Optional: development leaves it empty.
GATE_MAIL_FROM=

# GATE_TOOLBAR_EMAIL
# Staging's only. Optional: development leaves it empty.
GATE_TOOLBAR_EMAIL=

# E2E_STAGING_TOKEN
# The end-to-end suite's own token. It opens /api/staging/e2e and skips the
# order limit, and nothing else.
E2E_STAGING_TOKEN=dev-e2e-token
