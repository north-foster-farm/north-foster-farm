# Every key the functions, bin/nff and the e2e suite read, without
# values. Copy it to .env.development, .env.staging and
# .env.production (all ignored) and fill in each; every file is
# complete, since bin/nff reads only one. Locally, link .env to the
# one you work in: `ln -sf .env.development .env`. `bin/nff` reads
# .env; `bin/nff --production` and `--staging` read their own file.
# Netlify reads none of these: set its values with `netlify env:set`.

# Netlify Blobs, for bin/nff and the e2e back office. A personal
# access token. Unset, bin/nff keeps its records in memory.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# The deploy the links in emails point at, and whose URL Square signs
# its webhooks against (www included in production).
SITE_URL=
ACCOUNTS_ENABLED=

# Square: sandbox in development and staging, production in
# production. SQUARE_VERSION and SQUARE_WEBHOOK_URL have defaults.
SQUARE_ENV=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_VERSION=
SQUARE_WEBHOOK_URL=

# PayPal, for Venmo: sandbox or live.
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# 1 hides the Venmo button except from browsers that opened ?venmo.
VENMO_HIDDEN=

# Mail: resend in production, outbox on staging, file or unset
# (logged to the terminal) in development. MAIL_OUT is the file
# driver's folder.
MAIL_DRIVER=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_OUT=
ADMIN_EMAILS=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_AUDIENCE_KEY=

# Links in emails; both have defaults.
CONTACT_URL=
ADMIN_URL=

# Logs and alerts. Unset, each is skipped.
AXIOM_TOKEN=
AXIOM_DATASET=
HEALTHCHECKS_JOBS_URL=
HEALTHCHECKS_ALERT_URL=

# Staging only: guards /api/staging and lets the e2e suite read the
# outbox without the Netlify pair.
STAGING_TOKEN=
