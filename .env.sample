# Every key the functions, bin/nff and the e2e suite read, without
# values. Copy it to .env.development, .env.staging and
# .env.production (all ignored) and fill in each; every file is
# complete, since bin/nff reads only one. Locally, link .env to the
# one you work in: `ln -sf .env.development .env`. `bin/nff` reads
# .env; `bin/nff --production` and `--staging` read their own file.
# Netlify reads none of these: set its values with `netlify env:set`.

# Netlify Blobs, for bin/nff. The Netlify token is not here: it lives only
# in the macOS Keychain (docs/secrets.md, "Netlify"). Unset, bin/nff keeps
# its records in memory.
NETLIFY_SITE_ID=

# The deploy the links in emails point at, and whose URL Square signs
# its webhooks against (www included in production).
SITE_URL=
ACCOUNTS_ENABLED=

# Square: sandbox in development and staging, production in
# production. SQUARE_VERSION and SQUARE_WEBHOOK_URL have defaults.
SQUARE_ENV=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_SIGNATURE_KEY_PREVIOUS=
SQUARE_VERSION=
SQUARE_WEBHOOK_URL=

# PayPal, for Venmo: sandbox or live.
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# 1 hides the Venmo button except from browsers that opened ?venmo.
VENMO_HIDDEN=

# Mail: resend in production, outbox on staging, file or unset
# (logged to the terminal) in development. MAIL_OUT is the file
# driver's folder.
MAIL_DRIVER=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_OUT=
# The farm's notices: each new order, contact messages, the daily
# reports. Comma-separated.
FARM_NOTIFICATIONS_EMAIL=
# The developer's notices: every alert, rotations, security. No
# fallback; unset fails the production build.
DEV_NOTIFICATIONS_EMAIL=
# One emergency only: orders not recorded, unacknowledged for an hour.
# Nothing else is ever sent here.
ESCALATED_NOTIFICATIONS_EMAIL=
RESEND_API_KEY=
# The sending key's name in Resend (not secret): the send breaker deletes
# the key with this name when it trips.
RESEND_SENDING_KEY_NAME=
RESEND_AUDIENCE_ID=
RESEND_AUDIENCE_KEY=
# The Resend webhook endpoint's signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=

# Links in emails; both have defaults.
CONTACT_URL=
ADMIN_URL=

# Logs and alerts. Unset, each is skipped.
AXIOM_TOKEN=
AXIOM_DATASET=
HEALTHCHECKS_JOBS_URL=
HEALTHCHECKS_ALERT_URL=
HEALTHCHECKS_BACKUP_URL=
# The packing slips' check; production only (lib/packing.mjs).
HEALTHCHECKS_PACKING_URL=

# The backup export (docs/backup.md): James's age public key, and the
# R2 bucket and its bucket-scoped token as an S3 key pair. Production
# only; unset, the nightly run does nothing. A Backblaze B2 second
# copy (BACKUP_B2_*) is planned for after launch.
BACKUP_AGE_RECIPIENT=
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# Signs the phone links that flip maintenance mode (docs/maintenance.md).
# Any long random string, one per context; `bin/nff maintenance links`
# prints the links. Unset, the links are dead and only the CLI flips it.
MAINTENANCE_SECRET

# Staging only: machines only (the jobs workflow, health checks). It
# guards /api/staging/jobs/run and is never typed into a browser.
STAGING_TOKEN=

# Staging only: the access gate's own Resend sending key, never
# production's. It sends the gate's sign-in link and nothing else.
GATE_RESEND_KEY=
# Staging only: the gate's sender, "Name <address>" on a verified domain.
GATE_MAIL_FROM=
# Staging only: the one address whose gate session opens the staging
# toolbar.
GATE_TOOLBAR_EMAIL=

# Staging only: the end-to-end suite's own token. It opens
# /api/staging/e2e (records, mail, the maintenance switch) and skips the
# order limit, and nothing else. The suite holds this and no Netlify
# token (#266).
E2E_STAGING_TOKEN=
