#!/usr/bin/env node
// The farm's command line for orders, customers, stock and sign-in.
// Reads one env file from the repo root: .env (linked to
// .env.development) with no flag, or .env.production, .env.staging or
// .env.preview when that flag is given. Off Netlify the records live
// in the site's Blobs stores only when NETLIFY_SITE_ID and
// NETLIFY_AUTH_TOKEN are set; otherwise everything is in memory and
// lost on exit, which the banner says.

import { spawn } from "node:child_process";
import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

import { loadEnv } from "../netlify/functions/lib/env.mjs";

const USAGE = `Usage:
  bin/nff customers list
  bin/nff customers show <email>
  bin/nff customers set <email> name=.. phone=.. group=friends|none
  bin/nff customers delete <email>
  bin/nff customers rename <old> <new> [--apply]
                                      a customer's email changed: the
                                      record, orders, links, the Resend
                                      contact and the Square customer
                                      move; sessions end. A dry run
                                      unless --apply
  bin/nff address approve|deny <email>
  bin/nff orders list [--open] [--status=paid] [--email=x]
  bin/nff orders show <id>
  bin/nff orders cancel <id> --reason <why> | --reason-text "..." |
                             --no-reason [--no-refund] [--amount 12.34]
                                      the money back first, all of it
                                      unless told; then stock back and
                                      the fulfilment closed in Square;
                                      --no-refund only on purpose. The
                                      customer is told why: sold-out,
                                      delay, weather, emergency or
                                      mistake, or your own words;
                                      --no-reason for a customer we
                                      won't serve (write to them)
  bin/nff orders refund <id> [--amount 12.34] [--reason "..."]
                                      money back without cancelling:
                                      card and wallets through Square,
                                      Venmo through PayPal
  bin/nff orders attempted <id> <cause> [--detail "..."] [--waive "why"]
                                      a delivery we could not leave. The
                                      cause: no-cooler, no-access or
                                      no-address (the customer's miss:
                                      the fee is kept through any refund
                                      unless waived; waive a no-address
                                      when in doubt), or weather or farm
                                      (waived). --detail: where we
                                      couldn't get to, for the email
  bin/nff orders fulfil <id>
  bin/nff orders delete <id>
  bin/nff returns resolve <id> <returnId> [note...]
  bin/nff messages [--all]            messages to the farm not yet
                                      answered, from the contact page
                                      and the help form, oldest first;
                                      --all adds the answered ones
  bin/nff messages done <id>          mark one answered, which takes it
                                      off the morning report
  bin/nff stock list
  bin/nff stock set <sku> <count|none>
  bin/nff login <email>               print a sign-in link
  bin/nff masquerade <email>          open a sign-in link as them
  bin/nff audience invite <csv> [--dry-run]   the confirmation email,
                                      once, to each address not yet in
  bin/nff audience sync [--dry-run]   the Resend audience and the
                                      records, made to agree
  bin/nff schedule check <file>       the pickup schedule, checked as a
                                      deploy checks it (W11d)
  bin/nff schedule set <file> --staging|--production
                                      check it, set PICKUP_SCHEDULE on
                                      Netlify, and start a deploy with
                                      PICKUP_SCHEDULE_HOOK if the env
                                      file has one
  bin/nff jobs run
  bin/nff jobs history [--n=20]       the last runs: errors, invariants
  bin/nff health                      what /api/health would answer
  bin/nff library [--staging]         James's approvals and rewrites
                                      from the email library, to port
  bin/nff library clear <id>          drop an email's, once ported
  bin/nff --production mail list [--since 2026-09-19] [--to <email>]
                                      what Resend sent and how it
                                      ended; addresses masked unless
                                      --to names one
  bin/nff --production mail show <id> [--to <email>]
                                      one email's headers, no body

  --production, --staging, --preview  act on that deploy context's
                                      data; with none, on the dev
                                      stores, never production's`;

const root = join(dirname(fileURLToPath(import.meta.url)), "..");

// Each env file is complete (.env.sample names every key), so a flag
// reads its own file and nothing else: production's keys never mix
// with the sandbox's. The deploy context is set by the flag, not the
// file, so no flag can reach production's stores by accident.
const CONTEXTS = {
  production: "production",
  staging: "branch-deploy",
  preview: "deploy-preview",
};
const context = Object.keys(CONTEXTS)
  .find((name) => process.argv.includes(`--${name}`)) || null;

loadEnv(join(root, context ? `.env.${context}` : ".env"));

const [
  { default: terms },
  admin,
  { requestLink },
  { runJobs, runsSince },
  { stores: makeStores },
  { CANCEL_REASONS, age, paymentPhrase, summaryLine },
  { inviteSubscribers, parseCsv, syncAudience },
  { dollars, toCents },
  { snapshot },
  { keptFee, paidTotal, refundedTotal },
  { library },
  review,
  { mailLinks },
  sent,
  { checkSchedule },
] = await Promise.all([
  import("../data/delivery.json", { with: { type: "json" } }),
  import("../netlify/functions/lib/admin.mjs"),
  import("../netlify/functions/lib/auth.mjs"),
  import("../netlify/functions/lib/jobs.mjs"),
  import("../netlify/functions/lib/store.mjs"),
  import("../netlify/functions/lib/templates.mjs"),
  import("../netlify/functions/lib/news.mjs"),
  import("../assets/scripts/order/lib/totals.mjs"),
  import("../netlify/functions/health.mjs"),
  import("../netlify/functions/lib/records.mjs"),
  import("../netlify/functions/lib/library.mjs"),
  import("../netlify/functions/lib/review.mjs"),
  import("../netlify/functions/lib/site.mjs"),
  import("../netlify/functions/lib/sent.mjs"),
  import("../assets/scripts/order/lib/schedule.mjs"),
]);

process.env.SITE_CONTEXT = context ? CONTEXTS[context] : "dev";
if (context === "production") console.error("[nff] Production.");

// Emails from here go by MAIL_DRIVER, as on Netlify. Unset, every
// message is logged to this terminal and nobody receives it, which
// is worth hearing before a confirm or a deny.
if (!["resend", "outbox", "file"].includes(process.env.MAIL_DRIVER || "")) {
  console.error("Mail: MAIL_DRIVER is not set, so emails are logged here"
    + " and not sent. Set it in .env.production (resend) or"
    + " .env.staging (outbox).");
}

const stores = makeStores();
const flags = {};
const words = [];

// Flags that take a value: `--reason "..."` as well as `--reason=...`.
const VALUED = ["reason", "amount", "note", "at", "until", "n", "since",
  "to", "waive", "detail", "reason-text"];
const args = process.argv.slice(2);

for (let i = 0; i < args.length; i += 1) {
  const m = args[i].match(/^--([a-z-]+)(?:=(.*))?$/);

  if (!m) {
    words.push(args[i]);
  } else if (m[2] !== undefined) {
    flags[m[1]] = m[2];
  } else if (VALUED.includes(m[1]) && i + 1 < args.length
    && !args[i + 1].startsWith("--")) {
    flags[m[1]] = args[i + 1];
    i += 1;
  } else {
    flags[m[1]] = true;
  }
}

const [group, action, ...rest] = words;
const out = (value) => console.log(
  typeof value === "string" ? value : JSON.stringify(value, null, 2)
);
const kv = (pairs) => Object.fromEntries(pairs.map((p) => {
  const eq = p.indexOf("=");

  return eq > 0 ? [p.slice(0, eq), p.slice(eq + 1)] : [p, true];
}));

if (!stores.persistent) {
  console.error("[nff] No NETLIFY_SITE_ID/NETLIFY_AUTH_TOKEN: using memory " +
    "stores. Nothing here persists.");
}

// A sign-in link for any customer. Following it is the masquerade.
const signIn = async (email, open) => {
  const r = await requestLink(stores, { email, next: "/account/" }, {
    send: false,
  });

  if (!r.ok) throw new Error(`Could not make a link: ${r.reason}.`);
  out(r.url);
  if (open) {
    spawn(process.platform === "darwin" ? "open" : "xdg-open", [r.url], {
      stdio: "ignore", detached: true,
    }).unref();
  }
};

// A schedule file, checked as a deploy checks it (W11d). -> { value,
// summary }: the variable's value, one date per entry, and a line to
// print. Throws with every problem.
const checkedSchedule = (file) => {
  if (!file) throw new Error("Which file? bin/nff schedule check <file>");

  const r = checkSchedule(readFileSync(file, "utf8"), {
    timeZone: terms.timeZone,
  });

  if (!r.ok) {
    throw new Error(`The schedule has ${r.errors.length} problem${
      r.errors.length === 1 ? "" : "s"}:\n  ${r.errors.join("\n  ")}`);
  }

  const byDate = new Map();

  for (const w of r.windows) {
    byDate.set(w.date, [...(byDate.get(w.date) || []), w.id]);
  }

  return {
    value: [...byDate].map(([date, ids]) => `${date} ${ids.join(" ")}`)
      .join("; "),
    summary: `${r.windows.length} window${
      r.windows.length === 1 ? "" : "s"} on ${byDate.size} day${
      byDate.size === 1 ? "" : "s"}, ${r.windows[0].date} through ${
      r.last}. It passes.`,
  };
};

// The Netlify CLI, as the env file's site and token, for the one
// command that changes a deploy's settings.
const netlify = (args) => new Promise((resolve, reject) => {
  const child = spawn("npx", ["netlify", ...args], {
    stdio: ["ignore", "ignore", "inherit"],
    env: process.env,
  });

  child.on("error", reject);
  child.on("exit", (code) => (code === 0 ? resolve()
    : reject(new Error(`netlify ${args[0]} failed (${code}).`))));
});

// What James approved or rewrote in the staging email library and
// is not yet in the code (lib/review.mjs).
const HOW = {
  port: { approval: "add it to APPROVED in lib/library.mjs",
    rewrite: "apply it to lib/templates.mjs" },
  stale: "made against an earlier version: clear it",
  code: "approved in the code since: clear it",
};

const libraryReview = async () => {
  if (action === "clear" && rest[0]) {
    await review.clear(stores, rest[0]);

    return out(`Cleared ${rest[0]}.`);
  }

  const items = await review.pending(stores, library, mailLinks());

  for (const r of items) {
    const how = r.state === "port" ? HOW.port[r.kind] : HOW[r.state];

    out(`${r.state.toUpperCase().padEnd(6)}${r.kind.padEnd(10)}${r.id}  ${
      (r.at || "").slice(0, 16)}\n      ${r.name || "(no such email)"}: ${
      how}`);
    if (r.diff) out(r.diff.map((l) => `      ${l}`).join("\n"));
  }

  return items.length ? undefined : out("Nothing waits to be ported.");
};

// What Resend sent from production (lib/sent.mjs). Only production
// sends through Resend, and only .env.production holds the key.
const mailLookup = async () => {
  if (context !== "production") {
    throw new Error("Mail is read from production's Resend: add"
      + " --production.");
  }

  const to = typeof flags.to === "string" ? flags.to : undefined;

  if (action === "show") return out(await sent.showSent(rest[0], { to }));
  if (action !== "list") {
    console.error(USAGE);
    process.exit(1);
  }

  const since = typeof flags.since === "string" ? flags.since : undefined;
  const rows = await sent.listSent({ since, to });

  for (const r of rows) {
    out(`${r.at.slice(0, 16)}  ${r.lastEvent.padEnd(10)}${r.id}  ${
      r.to.join(", ")}\n      ${r.subject}`);
  }

  return rows.length ? undefined : out("No emails.");
};

// Messages to the farm (#167): listed until marked answered, and the
// morning report lists them too.
const messages = async () => {
  if (action === "done") {
    if (!rest[0]) throw new Error("Which? bin/nff messages done <id>");

    const m = await admin.answerMessage(stores, rest[0]);

    return out(`Answered ${m.id} from ${m.name || m.email} (${
      m.answeredAt.slice(0, 16)}).`);
  }
  if (action) {
    console.error(USAGE);
    process.exit(1);
  }

  const now = new Date();
  const list = await admin.listMessages(stores, { all: !!flags.all });

  for (const m of list) {
    const order = m.orderId ? `  order ${m.orderId}${
      m.order === false ? " (not their order)" : ""}` : "";
    const gist = (m.subject || m.message || "").replace(/\s+/g, " ");

    out(`${m.id}  ${age(m.at, now).padEnd(15)}${m.from.padEnd(9)}${
      m.name ? `${m.name} <${m.email}>` : m.email}${order}${
      m.status === "open" ? "" : `  answered ${m.answeredAt.slice(0, 10)}`
    }\n      ${gist.length > 70 ? `${gist.slice(0, 69)}…` : gist}`);
  }

  return list.length ? undefined : out("No messages waiting on an answer.");
};

const run = async () => {
  if (group === "messages") return messages();
  if (group === "library") return libraryReview();
  if (group === "mail") return mailLookup();
  if (group === "login" && action) return signIn(action, false);
  if (group === "masquerade" && action) return signIn(action, true);

  switch (`${group} ${action}`) {
  case "customers list": {
    const list = await admin.listCustomers(stores);

    for (const c of list) {
      out(`${c.email}  ${c.name || "-"}  ${c.discountGroup || ""}  ${
        c.address ? `${c.address.zip} ${c.address.status}` : ""}`);
    }
    if (!list.length) out("No customers.");

    return undefined;
  }
  case "customers show":
    return out(await admin.showCustomer(stores, rest[0]));
  case "customers set":
    return out(await admin.setCustomer(stores, rest[0], kv(rest.slice(1)),
      terms.money));
  case "customers rename":
    return out(await admin.renameCustomer(stores, rest[0], rest[1], {
      apply: !!flags.apply,
    }));
  case "customers delete":
    await admin.removeCustomer(stores, rest[0]);

    return out(`Deleted ${rest[0]}.`);
  case "address approve":
  case "address deny":
    return out(await admin.decideAddress(stores, rest[0],
      action === "approve" ? "approved" : "denied"));
  case "orders list": {
    const list = await admin.listOrders(stores, {
      status: flags.status, email: flags.email, open: !!flags.open,
    });

    for (const o of list) out(summaryLine(o));
    if (!list.length) out("No orders.");

    return undefined;
  }
  case "orders show":
    return out(await admin.showOrder(stores, rest[0]));
  case "orders cancel": {
    // The customer is told why, from the list or in the farm's words
    // (T2a); saying nothing takes --no-reason (T2b).
    const reasons = Object.keys(CANCEL_REASONS);
    const reason = typeof flags.reason === "string" ? flags.reason : "";
    const reasonText = typeof flags["reason-text"] === "string"
      ? flags["reason-text"].trim() : "";
    const given = [!!reason, !!reasonText, !!flags["no-reason"]]
      .filter(Boolean).length;

    if (reason && !reasons.includes(reason)) {
      throw new Error(`--reason is one of: ${reasons.join(", ")}. ` +
        "Anything else goes in --reason-text \"...\".");
    }
    // A customer's own cancel was already emailed; the farm only
    // finishes it.
    const order = await admin.showOrder(stores, rest[0]);
    const asked = !!order.cancelRequested;

    if (given !== 1 && !(asked && given === 0)) {
      throw new Error(`Say why, once: --reason <${reasons.join("|")}>, ` +
        "--reason-text \"...\", or --no-reason for a customer we won't " +
        "serve.");
    }

    const amount = typeof flags.amount === "string" ? toCents(flags.amount)
      : undefined;
    const left = paidTotal(order) - keptFee(order) - refundedTotal(order);

    // James is told what goes back, and the way out, every time
    // (W11a-1, #233).
    if (flags["no-refund"]) {
      out("Cancelling without a refund (--no-refund).");
    } else if (left > 0 && order.status === "paid") {
      // "Visa ending 4242", "Visa ending 4242, then Venmo".
      const to = paymentPhrase(order).replace(/\$[\d,.]+ by /g, "");

      out(`Refunding ${dollars(amount === undefined ? left : amount)} to ${
        to}… Pass --no-refund to cancel without refunding.`);
    }

    return out(summaryLine(await admin.cancelOrder(stores, rest[0], {
      // A refund unless the farm says otherwise (T1c); --refund,
      // once required, still reads as the default.
      refund: !flags["no-refund"],
      amount,
      reason,
      reasonText,
    })));
  }
  case "orders refund": {
    const before = await admin.showOrder(stores, rest[0]);
    const refunded = await admin.refundOrder(stores, rest[0], {
      amount: typeof flags.amount === "string" ? toCents(flags.amount)
        : undefined,
      reason: typeof flags.reason === "string" ? flags.reason : "",
    });

    out(summaryLine(refunded));

    return out(`Refunded ${dollars(refundedTotal(refunded)
      - refundedTotal(before))} of ${paymentPhrase(refunded)}.`);
  }
  case "orders attempted": {
    if (flags.waive === true) throw new Error("--waive needs a reason.");
    if (flags.detail === true) throw new Error("--detail needs the words.");

    const marked = await admin.markAttempted(stores, rest[0], {
      cause: rest[1],
      waive: typeof flags.waive === "string" ? flags.waive : "",
      detail: typeof flags.detail === "string" ? flags.detail : "",
    });
    const { at, cause, fee } = marked.attempted;

    out(summaryLine(marked));

    return out(`Attempted ${at} (${cause || "no cause recorded"}); ${fee
      ? `the delivery fee of ${dollars(fee)} stays with the farm.`
      : "the delivery fee is waived."}`);
  }
  case "orders fulfil":
  case "orders fulfill":
    return out(summaryLine(await admin.fulfilOrder(stores, rest[0])));
  case "orders delete":
    await admin.removeOrder(stores, rest[0]);

    return out(`Deleted ${rest[0]}.`);
  case "returns resolve":
    return out(summaryLine(await admin.resolveReturn(stores, rest[0],
      rest[1], {
        note: rest.slice(2).join(" "),
        outcome: flags.outcome || "resolved",
      })));
  case "stock list":
    return out(await admin.stockList(stores));
  case "stock set":
    return out(await admin.stockSet(stores, rest[0], rest[1]));
  case "audience invite": {
    if (!rest[0]) throw new Error("Which CSV? bin/nff audience invite <csv>");

    const rows = parseCsv(readFileSync(rest[0], "utf8"));

    return out(await inviteSubscribers(stores, rows, {
      dryRun: !!flags["dry-run"],
    }));
  }
  case "audience sync":
    return out(await syncAudience(stores, { dryRun: !!flags["dry-run"] }));
  case "schedule check": {
    const checked = checkedSchedule(rest[0]);

    return out(checked.summary);
  }
  case "schedule set": {
    if (!context || context === "preview") {
      throw new Error("Say which: --staging or --production.");
    }

    const checked = checkedSchedule(rest[0]);
    // Staging is the staging branch's deploys.
    const targets = context === "production"
      ? ["production"] : ["branch:staging"];

    for (const target of targets) {
      await netlify(["env:set", "PICKUP_SCHEDULE", checked.value,
        "--context", target]);
    }
    out(checked.summary);
    out(`Set PICKUP_SCHEDULE for ${targets.join(" and ")}.`);

    // The functions read the variable as of their deploy.
    const hook = process.env.PICKUP_SCHEDULE_HOOK;

    if (!hook) {
      return out("Now deploy for it to take effect: Netlify, Deploys, " +
        "Trigger deploy (or PICKUP_SCHEDULE_HOOK, a build hook, in the " +
        "env file does it from here).");
    }

    const res = await fetch(hook, { method: "POST" });

    if (!res.ok) throw new Error(`The build hook answered ${res.status}.`);

    return out("Deploy started. It fails, and the last good one stays " +
      "live, if the schedule doesn't pass there either.");
  }
  case "jobs run":
    return out(await runJobs(stores));
  case "jobs history": {
    const n = Number(flags.n) || 20;
    const runs = await runsSince(stores, new Date(0));

    for (const r of runs.slice(0, n)) {
      const bad = (r.errors || []).length + (r.invariants || []).length;

      const c = r.counts || {};

      out(`${r.at.slice(0, 16)}  ${bad ? "FAIL" : "ok  "}  reminded ${
        c.deliveryReminded ?? 0}  closed ${c.closed ?? 0}  synced ${
        c.squareSynced ?? 0}  pickups ${c.pickupsToConfirm ?? 0}  swept ${
        r.checkoutsSwept ?? 0}  signins ${r.authSwept ?? 0}${
        (r.errors || []).map((e) => `\n    error ${e.id || "-"}: ${e.error}`)
          .join("")}${(r.invariants || []).map((v) =>
        `\n    invariant ${v.rule}: ${v.id}`).join("")}`);
    }
    if (!runs.length) out("No runs recorded.");

    return undefined;
  }
  case "health":
    return out(await snapshot(stores));
  default:
    console.error(USAGE);
    process.exit(1);
  }

  return undefined;
};

try {
  await run();
} catch (error) {
  console.error(error.message);
  process.exit(1);
}
