#!/usr/bin/env node
// The farm's command line for orders, customers, stock and sign-in.
// Reads one env file from the repo root: .env (linked to
// .env.development) with no flag, or .env.production, .env.staging or
// .env.preview when that flag is given. Off Netlify the records live
// in the site's Blobs stores only with a context flag (or --scratch)
// and a NETLIFY_SITE_ID; the token is read from the macOS Keychain
// (bin/env/keychain.mjs), never an env file. Otherwise everything is
// in memory and lost on exit, which the banner says.

import { spawn } from "node:child_process";
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { createInterface } from "node:readline";
import { fileURLToPath } from "node:url";

import { loadEnv } from "../netlify/functions/lib/env.mjs";
import { USAGE as BREAKER_USAGE, breakerCommand } from "./breaker.mjs";
import { confirmed } from "./confirm.mjs";
import { USAGE as GATE_USAGE, gateCommand } from "./gate.mjs";
import { devSchedule } from "./dev-schedule.mjs";
import { NETLIFY_NPX, runNetlify } from "./env/cli.mjs";
import { deployAfterPush } from "./env/deploy.mjs";
import {
  PREVIEW_ALLOWED, PREVIEW_CONTEXTS, TARGETS, checkEnv, envRunner, planPush,
  preflight, previewLeaks, pushEnv, redact, remoteFor, remoteVars,
} from "./env/netlify.mjs";
import { keychainToken, tokenInFiles } from "./env/keychain.mjs";
import { readSample, readValues, sampleFile } from "./env/sample.mjs";
import { verifyEnv } from "./env/verify.mjs";
import { setSchedule } from "./schedule-env.mjs";
import { USAGE as PROMOTE_USAGE, promoteCommand } from "./promote.mjs";
import { USAGE as SUPPLY_USAGE, supplyCommand } from "./supply/waive.mjs";

