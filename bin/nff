const root = join(dirname(fileURLToPath(import.meta.url)), "..");

// Each env file is complete (.env.sample names every key), so a flag
// reads its own file and nothing else: production's keys never mix
// with the sandbox's. The deploy context is set by the flag, not the
// file, so no flag can reach production's stores by accident.
const CONTEXTS = {
  production: "production",
  staging: "branch-deploy",
  preview: "deploy-preview",
};
const context = Object.keys(CONTEXTS)
  .find((name) => process.argv.includes(`--${name}`)) || null;

loadEnv(join(root, context ? `.env.${context}` : ".env"));

// The Netlify token comes from the Keychain and nowhere else (#267):
// not from an env file, not from the shell. Development runs on
// memory stores and never looks; a context, or --scratch's stores in
// Blobs, needs it. A missing item stops here, saying so, rather than
// falling back to memory stores that lose the work.
delete process.env.NETLIFY_AUTH_TOKEN;
const passthrough = process.argv[2] === "netlify";

if (context || passthrough || process.argv.includes("--scratch")) {
  try {
    process.env.NETLIFY_AUTH_TOKEN = keychainToken();
  } catch (error) {
    console.error(`[nff] ${error.message}`);
    process.exit(1);
  }
}

// `bin/nff netlify <args>`: the Netlify CLI itself, as the Keychain's
// token, so the runbooks need no `netlify login` and the CLI's own
// plaintext login can be removed. Everything after `netlify` goes to
// it untouched.
if (passthrough) {
  try {
    process.exit(await runNetlify(process.argv.slice(3),
      process.env.NETLIFY_AUTH_TOKEN));
  } catch (error) {
    console.error(`[nff] netlify would not start: ${error.message}`);
    process.exit(1);
  }
}

// Development's pickup schedule is made up, from today (#264), so
// .env needs none; a context's comes from `schedule set`.
if (!context && !process.env.PICKUP_SCHEDULE) {
  process.env.PICKUP_SCHEDULE = devSchedule();
}

const [
  { default: terms },
  admin,
  { requestLink },
  { runJobs, runsSince, sweepMadeCustomers, sweepSquareOrders },
  { stores: makeStores },
  { CANCEL_REASONS, paymentPhrase, summaryLine },
  { inviteSubscribers, parseCsv, syncAudience },
