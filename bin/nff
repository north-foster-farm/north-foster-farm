]);

// --scratch: development's env, but stores of their own
// (scratch-orders, ...), for the restore rehearsal (docs/backup.md).
const scratch = !context && process.argv.includes("--scratch");

process.env.SITE_CONTEXT = context ? CONTEXTS[context]
  : scratch ? "scratch" : "dev";
if (context === "production") console.error("[nff] Production.");

// Emails from here go by MAIL_DRIVER, as on Netlify. Unset, every
// message is logged to this terminal and nobody receives it, which
// is worth hearing before a confirm or a deny.
if (!["resend", "outbox", "file"].includes(process.env.MAIL_DRIVER || "")) {
  console.error("Mail: MAIL_DRIVER is not set, so emails are logged here"
    + " and not sent. Set it in .env.production (resend) or"
    + " .env.staging (outbox).");
}

const stores = makeStores();
const flags = {};
const words = [];

// Flags that take a value: `--reason "..."` as well as `--reason=...`.
const VALUED = ["reason", "amount", "note", "at", "until", "n", "since",
  "to", "waive", "detail", "reason-text", "sha", "deploy", "label",
  "out", "count", "hours", "advisory", "file", "email", "days", "method",
  "date", "window", "phone", "contact", "address1", "address2", "town",
  "zip", "cooler", "gate", "delivery-notes", "notes", "key"];
const args = process.argv.slice(2);

for (let i = 0; i < args.length; i += 1) {
  const m = args[i].match(/^--([a-z-]+)(?:=(.*))?$/);

  if (!m) {
    words.push(args[i]);
  } else if (m[2] !== undefined) {
    flags[m[1]] = m[2];
  } else if (VALUED.includes(m[1]) && i + 1 < args.length
    && !args[i + 1].startsWith("--")) {
    flags[m[1]] = args[i + 1];
    i += 1;
  } else {
    flags[m[1]] = true;
  }
}

const [group, action, ...rest] = words;
const out = (value) => console.log(
  typeof value === "string" ? value : JSON.stringify(value, null, 2)
);
const kv = (pairs) => Object.fromEntries(pairs.map((p) => {
  const eq = p.indexOf("=");

  return eq > 0 ? [p.slice(0, eq), p.slice(eq + 1)] : [p, true];
}));

if (!stores.persistent) {
  console.error("[nff] No NETLIFY_SITE_ID or Keychain token: using memory " +
    "stores. Nothing here persists.");
}

// A sign-in link for any customer. Following it is the masquerade.
const signIn = async (email, open) => {
  const r = await requestLink(stores, { email, next: "/account/" }, {
    send: false,
  });

  if (!r.ok) throw new Error(`Could not make a link: ${r.reason}.`);
  out(r.url);
  if (open) {
    spawn(process.platform === "darwin" ? "open" : "xdg-open", [r.url], {
      stdio: "ignore", detached: true,
    }).unref();
  }
};

// A schedule file, checked as a deploy checks it (W11d). -> { value,
// summary }: the variable's value, one date per entry, and a line to
// print. Throws with every problem.
const checkedSchedule = (file) => {
  if (!file) throw new Error("Which file? bin/nff schedule check <file>");

  const r = checkSchedule(readFileSync(file, "utf8"), {
    timeZone: terms.timeZone,
  });

  if (!r.ok) {
    throw new Error(`The schedule has ${r.errors.length} problem${
      r.errors.length === 1 ? "" : "s"}:\n  ${r.errors.join("\n  ")}`);
  }

  const byDate = new Map();

  for (const w of r.windows) {
    byDate.set(w.date, [...(byDate.get(w.date) || []), w.id]);
  }

  return {
    value: [...byDate].map(([date, ids]) => `${date} ${ids.join(" ")}`)
      .join("; "),
    summary: `${r.windows.length} window${
      r.windows.length === 1 ? "" : "s"} on ${byDate.size} day${
      byDate.size === 1 ? "" : "s"}, ${r.windows[0].date} through ${
      r.last}. It passes.`,
  };
};

// The Netlify CLI, as the env file's site and token, for the one
// command that changes a deploy's settings. -> its stdout.
const netlify = (args) => new Promise((resolve, reject) => {
  const child = spawn("npx", [...NETLIFY_NPX, ...args], {
    stdio: ["ignore", "pipe", "inherit"],
    env: process.env,
  });
  let stdout = "";

  child.stdout.on("data", (chunk) => { stdout += chunk; });
  child.on("error", reject);
  child.on("close", (code) => (code === 0 ? resolve(stdout)
    : reject(new Error(`netlify ${args[0]} failed (${code}).`))));
});

// What James approved or rewrote in the staging email library and
// is not yet in the code (lib/review.mjs).
const HOW = {
  port: { approval: "add it to APPROVED in lib/library.mjs",
    rewrite: "apply it to lib/templates.mjs" },
  stale: "made against an earlier version: clear it",
  code: "approved in the code since: clear it",
};

const libraryReview = async () => {
  if (action === "clear" && rest[0]) {
    await review.clear(stores, rest[0]);

    return out(`Cleared ${rest[0]}.`);
  }

  const items = await review.pending(stores, library, mailLinks());

  for (const r of items) {
    const how = r.state === "port" ? HOW.port[r.kind] : HOW[r.state];

    out(`${r.state.toUpperCase().padEnd(6)}${r.kind.padEnd(10)}${r.id}  ${
      (r.at || "").slice(0, 16)}\n      ${r.name || "(no such email)"}: ${
      how}`);
    if (r.diff) out(r.diff.map((l) => `      ${l}`).join("\n"));
  }

  return items.length ? undefined : out("Nothing waits to be ported.");
};

// The env file and its tracked sample, for env push and env check
// (#264). Values stay in memory; every line printed names keys only.
let held = [];

const envFiles = () => {
  if (!["production", "staging"].includes(context)) {
    throw new Error("Say which: --staging or --production.");
  }

  const file = `.env.${context}`;
  const read = (name) => {
    try {
      return readFileSync(join(root, name), "utf8");
    } catch {
      throw new Error(`No ${name} in ${root}.`);
    }
  };

  const local = readValues(read(file));

  // Whatever is printed from here on is scrubbed of these, errors
  // included (the catch at the foot of this file).
  held = [...local.values.values(), process.env.NETLIFY_AUTH_TOKEN];

  return {
    file,
    sample: readSample(read(sampleFile(context)), context),
    local,
  };
};

// The Netlify CLI for env commands: its output is kept, and an error
// shows it with every value blanked.
const envNetlify = (values) => (args) => new Promise((resolve, reject) => {
  const child = spawn("npx", [...NETLIFY_NPX, ...args], {
    stdio: ["ignore", "pipe", "pipe"],
    env: process.env,
  });
  let stdout = "";
  let stderr = "";

  child.stdout.on("data", (chunk) => { stdout += chunk; });
  child.stderr.on("data", (chunk) => { stderr += chunk; });
  child.on("error", reject);
  child.on("close", (code) => (code === 0 ? resolve(stdout)
    : reject(new Error(`netlify ${args[0]} ${args[1] || ""} failed (${
      code}):\n${redact(`${stderr}${stdout}`, values).trim()}`))));
});

// After a push and the deploy: one harmless call per service, by name
// (bin/env/verify.mjs). Reads the env file only, never Netlify.
const envVerify = async (file, local) => {
  const r = await verifyEnv(context, local.values);

  for (const line of r.lines) out(line);
  out(`Not checked, no harmless call exists: ${r.unchecked.join(", ")}.`);
  if (r.failed) {
    throw new Error(`Env verify: ${r.failed} credential${
      r.failed === 1 ? "" : "s"} in ${file} failed.`);
  }

  return out(`Env verify: every credential tried in ${file} works.`);
};

const askLine = (question) => new Promise((resolve) => {
  const rl = createInterface({ input: process.stdin, output: process.stdout });

  rl.question(question, (answer) => {
    rl.close();
    resolve(answer);
  });
});

const envCommand = async () => {
  const { file, sample, local } = envFiles();
  const { context: target } = TARGETS[context];

  if (action === "verify") return envVerify(file, local);

  const secrets = [...local.values.values()];
  const cli = envRunner({
    cli: envNetlify(secrets),
    token: process.env.NETLIFY_AUTH_TOKEN,
    values: secrets,
  });
  const site = local.values.get("NETLIFY_SITE_ID")
    || process.env.NETLIFY_SITE_ID;

  if (!site) throw new Error(`No NETLIFY_SITE_ID in ${file}. Nothing done.`);

  if (action === "push") {
    const plan = planPush(sample, local, file);
    const errors = plan.errors.length ? plan.errors
      : preflight(plan, await remoteVars(cli, site));

    if (errors.length) {
      throw new Error(`Nothing set. Fix these first:\n  ${
        errors.join("\n  ")}`);
    }

    const pushed = await pushEnv(cli, plan, target, site);

    out(`Set ${pushed.set.length} keys on ${target} of site ${site}${
      plan.skipped.length ? `; skipped ${plan.skipped.join(", ")}` : ""}.`);
    if (pushed.error) {
      const { name, message } = pushed.error;
      const took = pushed.set.filter((n) => n !== name);

      throw new Error(`Stopped at ${name}: ${message.startsWith("set, but")
        ? message : `failed: ${message}`}\nSet: ${
        took.join(", ") || "none"}.\n${
        pushed.failed.length ? `Didn't read back: ${
          pushed.failed.join(", ")}.\n` : ""}Not tried: ${
        pushed.untried.join(", ") || "none"}. Push again once it's fixed.`);
    }
    if (pushed.failed.length) {
      throw new Error(`These didn't read back: ${pushed.failed.join(", ")}.`);
    }

    // Secrets can't be read back: confirm them by name.
    const remote = remoteFor(await remoteVars(cli, site), context);
    const absent = plan.sets.filter((s) => s.secret && !remote.has(s.name))
      .map((s) => s.name);

    if (absent.length) {
      throw new Error(`These secrets aren't on ${target}: ${
        absent.join(", ")}.`);
    }

    out("Every value read back, and every secret is there by name. " +
      "Now `bin/nff env check`.");

    const tty = process.stdin.isTTY && process.stdout.isTTY;
    const lines = await deployAfterPush({
      context,
      hook: local.values.get("PICKUP_SCHEDULE_HOOK"),
      allow: !!flags["allow-deploy"],
      ask: tty ? askLine : null,
    });

    for (const line of lines) out(line);

    return undefined;
  }

  if (action === "check") {
    const vars = await remoteVars(cli, site);
    const remote = remoteFor(vars, context);
    const found = checkEnv({
      env: context, sample, local, remote, file,
    });

    found.problems.push(...tokenInFiles(root));
    const leaks = previewLeaks(vars);
    const problems = [...found.problems, ...leaks.problems];
    const unset = [...found.unset, ...leaks.unset];

    if (!problems.length) {
      return out(`${sampleFile(context)}, ${file} and ${target} agree on ${
        sample.keys.length} keys, none shared. ${
        PREVIEW_CONTEXTS.join(" and ")} hold only ${
        [...PREVIEW_ALLOWED].join(" and ")}: no production value.`);
    }
    for (const p of problems) console.error(`  ${p}`);
    if (unset.length) {
      console.error("Push never deletes. To clear those names, run:");
      for (const u of unset) console.error(`  ${u}`);
    }
    throw new Error(`Env check: ${problems.length} problem${
      problems.length === 1 ? "" : "s"}.`);
  }

  console.error(USAGE);

  return process.exit(1);
};

// A report as the log keeps it (one JSON line, from Axiom or the
// console), or a bare stack and --sha. The maps are the deploy's that
// built the report's commit, found on the context's branch (--staging,
// --production), or the one --deploy names.
const BRANCHES = { production: "main", staging: "staging" };

const errorsShow = async (file) => {
  if (!file) {
    throw new Error("Usage: bin/nff errors show <file|-> [--sha <commit>] " +
      "[--deploy <id>]");
  }

  const raw = readFileSync(file === "-" ? 0 : file, "utf8");
  let report;

  try {
    report = JSON.parse(raw);
  } catch {
    report = { stack: raw };
  }

  const sha = flags.sha || report.build;
  const siteID = process.env.NETLIFY_SITE_ID;
  const token = process.env.NETLIFY_AUTH_TOKEN;

  if (!siteID || !token) {
    throw new Error("Needs NETLIFY_SITE_ID in the env file and the " +
      "Keychain's Netlify token (a context flag reads it).");
  }
  if (!sha && typeof flags.deploy !== "string") {
    throw new Error("No build in the report: pass --sha or --deploy.");
  }

  let deployID = typeof flags.deploy === "string" ? flags.deploy : null;

  if (!deployID) {
    const branch = BRANCHES[context] || null;
    const deploy = await sourcemaps.findDeploy({ sha, siteID, token, branch });

    if (!deploy) {
      throw new Error(`No ready deploy of ${sha}${
        branch ? ` on ${branch}` : ""}: its maps went with it, or pass ` +
        "--deploy <id>.");
    }
    deployID = deploy.id;
  }
  out(`${report.kind || report.event || "report"}  ${
    report.where || ""}  build ${sha || "?"}  deploy ${deployID}`);
  if (report.message) out(`  ${report.message}`);

  const maps = sourcemaps.deployMaps({ deployID, siteID, token });
  const mapped = await sourcemaps.mapStack(report.stack,
    (key) => maps.get(key));

  if (!mapped.length) return out("No frames in the stack.");

  return out(sourcemaps.formatMapped(mapped).join("\n"));
};

// A copy before and after a release, or whenever: the nightly run's
// export, labelled. No ping, so it never stands in for a missed night.
const exportCommand = async () => {
  const label = String(flags.label || "manual").replace(/[^a-z0-9-]/gi, "-");
  const r = await backup.exportBackup(stores, {
    label, upload: !flags.out,
  });

  if (flags.out) writeFileSync(flags.out, r.encrypted);
  out(`Backup: ${r.counts.orders} orders, ${r.counts.customers} ` +
    `customers (${r.counts.subscribers} subscribed), ${r.bytes} bytes, ` +
    `encrypted.`);
  out(flags.out ? `  Written to ${flags.out}.`
    : `  In ${process.env.BACKUP_R2_BUCKET} as ${r.key}.`);
};

// The rehearsal's restore (docs/backup.md): never into production.
const restoreCommand = async (file) => {
  if (!scratch) throw new Error("Restore writes only with --scratch.");
  if (flags.clear) {
    for (const name of backup.BACKED_UP) {
      for (const { key } of await stores[name].list("")) {
        await stores[name].delete(key);
      }
    }

    return out("Scratch stores emptied.");
  }
  if (!file) throw new Error("Usage: bin/nff restore <file.json> --scratch");

  const r = await backup.restore(stores,
    JSON.parse(readFileSync(file, "utf8")));
  const same = JSON.stringify(r.expected) === JSON.stringify(r.found);

  out({ expected: r.expected, found: r.found });
  out(same ? "Restore: every count matches." : "Restore: counts DIFFER.");
  if (!same) process.exitCode = 1;
};

// Messages to the farm (#167): listed until marked answered, and the
// morning report lists them too.
const messages = async () => {
  if (action === "done") {
    if (!rest[0]) throw new Error("Which? bin/nff messages done <id>");

    const m = await admin.answerMessage(stores, rest[0]);

    return out(admin.answeredLine(m));
  }
  if (action) {
    console.error(USAGE);
    process.exit(1);
  }

  const now = new Date();
  const list = await admin.listMessages(stores, { all: !!flags.all });

  for (const m of list) out(admin.messageLine(m, now));

  return list.length ? undefined : out("No messages waiting on an answer.");
};

const run = async () => {
  if (group === "env") return envCommand();
  if (group === "breaker") {
    return breakerCommand(action, { stores, flags, out, root });
  }
  if (group === "gate") {
    return gateCommand(action, rest, {
      stores, flags, out, context: process.env.SITE_CONTEXT,
    });
  }
  if (group === "promote") {
    return promoteCommand(action, rest, { flags, out });
  }
  if (group === "supply") {
    return supplyCommand(action, rest, { flags, out, root });
  }
  if (group === "messages") return messages();
  if (group === "library") return libraryReview();
  if (group === "export") return exportCommand();
  if (group === "restore") return restoreCommand(action);
  if (group === "login" && action) return signIn(action, false);
  if (group === "masquerade" && action) return signIn(action, true);

  // Production asks first for anything that cancels, refunds, deletes
  // or changes an order or stock (#268); --yes is for a script.
  if (!await confirmed({ group, action, rest }, {
    context, flags, ask: process.stdin.isTTY ? askLine : null,
  })) {
    process.exit(1);
  }

  switch (`${group} ${action}`) {
  case "customers list": {
    const list = await admin.listCustomers(stores);

    for (const c of list) {
      out(`${c.email}  ${c.name || "-"}  ${c.discountGroup || ""}  ${
        c.address ? `${c.address.zip} ${c.address.status}` : ""}`);
    }
    if (!list.length) out("No customers.");

    return undefined;
  }
  case "customers show":
    return out(await admin.showCustomer(stores, rest[0]));
  case "customers set":
    return out(await admin.setCustomer(stores, rest[0], kv(rest.slice(1)),
      terms.money));
  case "customers quiet": {
    const list = await admin.quietCustomers(stores);

    for (const c of list) {
      out(`${c.email}  last ${c.lastInteraction}${
        c.onFarmNews ? "  on farm news" : ""}`);
    }
    if (!list.length) out("No quiet accounts due.");

    return undefined;
  }
  case "customers rename":
    return out(await admin.renameCustomer(stores, rest[0], rest[1], {
      apply: !!flags.apply,
    }));
  case "customers forget":
    return out(await admin.forgetCustomer(stores, rest[0], {
      apply: !!flags.apply,
    }));
  case "customers delete":
    await admin.removeCustomer(stores, rest[0]);

    return out(`Deleted ${rest[0]}.`);
  case "address approve":
  case "address deny":
    return out(await admin.decideAddress(stores, rest[0],
      action === "approve" ? "approved" : "denied"));
  case "orders list": {
    const list = await admin.listOrders(stores, {
      status: flags.status, email: flags.email, open: !!flags.open,
    });

    for (const o of list) out(summaryLine(o));
    if (!list.length) out("No orders.");

    return undefined;
  }
  case "orders show":
    return out(await admin.showOrder(stores, rest[0]));
  case "orders cancel": {
    // The customer is told why, from the list or in the farm's words
    // (T2a); saying nothing takes --no-reason (T2b).
    const reasons = Object.keys(CANCEL_REASONS);
    const reason = typeof flags.reason === "string" ? flags.reason : "";
    const reasonText = typeof flags["reason-text"] === "string"
      ? flags["reason-text"].trim() : "";
    const given = [!!reason, !!reasonText, !!flags["no-reason"]]
      .filter(Boolean).length;

    if (reason && !reasons.includes(reason)) {
      throw new Error(`--reason is one of: ${reasons.join(", ")}. ` +
        "Anything else goes in --reason-text \"...\".");
    }
    // A customer's own cancel was already emailed; the farm only
    // finishes it.
    const order = await admin.showOrder(stores, rest[0]);
    const asked = !!order.cancelRequested;

    if (given !== 1 && !(asked && given === 0)) {
      throw new Error(`Say why, once: --reason <${reasons.join("|")}>, ` +
        "--reason-text \"...\", or --no-reason for a customer we won't " +
        "serve.");
    }

    const amount = typeof flags.amount === "string" ? toCents(flags.amount)
      : undefined;
    const left = paidTotal(order) - keptFee(order) - refundedTotal(order);

    // James is told what goes back, and the way out, every time
    // (W11a-1, #233).
    if (flags["no-refund"]) {
      out("Cancelling without a refund (--no-refund).");
    } else if (left > 0 && order.status === "paid") {
      // "Visa ending 4242", "Visa ending 4242, then Venmo".
      const to = paymentPhrase(order).replace(/\$[\d,.]+ by /g, "");

      out(`Refunding ${dollars(amount === undefined ? left : amount)} to ${
        to}… Pass --no-refund to cancel without refunding.`);
    }

    return out(summaryLine(await admin.cancelOrder(stores, rest[0], {
      // A refund unless the farm says otherwise (T1c); --refund,
      // once required, still reads as the default.
      refund: !flags["no-refund"],
      amount,
      reason,
      reasonText,
    })));
  }
  case "orders refund": {
    const before = await admin.showOrder(stores, rest[0]);
    const refunded = await admin.refundOrder(stores, rest[0], {
      amount: typeof flags.amount === "string" ? toCents(flags.amount)
        : undefined,
      reason: typeof flags.reason === "string" ? flags.reason : "",
    });

    out(summaryLine(refunded));

    return out(`Refunded ${dollars(refundedTotal(refunded)
      - refundedTotal(before))} of ${paymentPhrase(refunded)}.`);
  }
  case "orders attempted": {
    if (flags.waive === true) throw new Error("--waive needs a reason.");
    if (flags.detail === true) throw new Error("--detail needs the words.");

    const marked = await admin.markAttempted(stores, rest[0], {
      cause: rest[1],
      waive: typeof flags.waive === "string" ? flags.waive : "",
      detail: typeof flags.detail === "string" ? flags.detail : "",
    });
    const { at, cause, fee, date } = marked.attempted;
    const moved = !!date && marked.fulfilment.date !== date;
    const asked = marked.question && marked.question.kind === "missed";

    out(summaryLine(marked));
    out(`Attempted ${at} (${cause || "no cause recorded"}); ${fee
      ? `the delivery fee of ${dollars(fee)} stays with the farm.`
      : "the delivery fee is waived."}`);

    if (moved) {
      return out(`Moved to ${marked.fulfilment.date}; the customer is told.`);
    }
    if (admin.missedUntold(marked)) {
      return out("The email to the customer failed, so nothing is held yet. " +
        "Run this again to resend it; the jobs also try each run.");
    }

    return asked
      ? out(`The customer is asked to choose by ${marked.question.until}.`)
      : undefined;
  }
  case "orders move":
    return out(summaryLine(await admin.moveDelivery(stores, rest[0],
      rest[1])));
  case "orders change": {
    const given = (k) => (typeof flags[k] === "string" ? flags[k] : undefined);
    const pick = (obj) => Object.fromEntries(Object.entries(obj)
      .filter(([, v]) => v !== undefined));
    const method = given("method") === "dropsite" ? "scituate"
      : given("method");
    const onfarm = pick({ window: given("window") });
    const delivery = pick({
      address1: given("address1"), address2: given("address2"),
      town: given("town"), zip: given("zip"), cooler: given("cooler"),
      gate: given("gate"), notes: given("delivery-notes"),
    });
    const customer = pick({
      phone: given("phone"), contact: given("contact"),
    });
    const body = pick({
      fulfilment: pick({
        method, date: given("date"),
        onfarm: Object.keys(onfarm).length ? onfarm : undefined,
        delivery: Object.keys(delivery).length ? delivery : undefined,
      }),
      customer: Object.keys(customer).length ? customer : undefined,
      notes: given("notes"),
    });

    if (!rest[0]) throw new Error("Which order? orders change <id> ...");
    if (!Object.keys(body.fulfilment).length && !body.customer
      && body.notes === undefined) {
      throw new Error("Nothing to change. Give --method, --date, " +
        "--window, an address, --cooler, --gate, --phone or --notes.");
    }

    const r = await farmEdit(stores, rest[0], body, {
      key: given("key"), dryRun: !!flags["dry-run"],
      onKey: (k) => out(`Key: ${k} (pass --key ${k} to retry)`),
    });

    if (!r.ok) {
      throw new Error(Object.values(r.errors).join(" "));
    }
    if (r.dryRun) {
      out(summaryLine(r.order));
      out(`--dry-run: nothing saved or sent. The customer would get:\n`);
      out(`Subject: ${r.email.subject}\n\n${r.email.text}`);

      return undefined;
    }

    out(summaryLine(r.order));
    if (r.outOfSync) {
      out("Square did not take the change: the order is flagged out of " +
        "sync. Fix the Square order by hand; the farm has been told.");
    }

    return undefined;
  }
  case "orders fulfil":
  case "orders fulfill":
    return out(summaryLine(await admin.fulfilOrder(stores, rest[0])));
  case "orders delete":
    await admin.removeOrder(stores, rest[0]);

    return out(`Deleted ${rest[0]}.`);
  case "refunds check": {
    const r = await checkRefunds(stores);
    const line = (word, x) => out(`${word.padEnd(10)}${x.id}  ${
      dollars(x.amount)}  ${x.via || "no id"} ${x.refund || ""}  ${
      (x.at || "").slice(0, 10)}  ${x.status || x.error || ""}`);

    for (const x of r.failed) line("FAILED", x);
    for (const x of r.stalled) line("STALLED", x);
    for (const x of r.errors) line("ERROR", x);
    for (const x of r.pending) line("pending", x);
    for (const x of r.completed) line("settled", x);

    return out(r.checked ? `Checked ${r.checked}.`
      : "Every refund has settled.");
  }
  case "returns resolve":
    return out(summaryLine(await admin.resolveReturn(stores, rest[0],
      rest[1], {
        note: rest.slice(2).join(" "),
        outcome: flags.outcome || "resolved",
      })));
  case "stock list":
    return out(await admin.stockList(stores));
  case "stock set":
    return out(await admin.stockSet(stores, rest[0], rest[1]));
  case "audience invite": {
    if (!rest[0]) throw new Error("Which CSV? bin/nff audience invite <csv>");

    const rows = parseCsv(readFileSync(rest[0], "utf8"));

    return out(await inviteSubscribers(stores, rows, {
      dryRun: !!flags["dry-run"],
    }));
  }
  case "audience sync":
    return out(await syncAudience(stores, { dryRun: !!flags["dry-run"] }));
  case "schedule check": {
    const checked = checkedSchedule(rest[0]);

    return out(checked.summary);
  }
  case "schedule set": {
    if (!context || context === "preview") {
      throw new Error("Say which: --staging or --production.");
    }

    const checked = checkedSchedule(rest[0]);
    // Staging is the staging branch's deploys.
    const targets = context === "production"
      ? ["production"] : ["branch:staging"];

    await setSchedule(netlify, checked.value, targets,
      process.env.NETLIFY_SITE_ID);
    out(checked.summary);
    out(`Set PICKUP_SCHEDULE for ${targets.join(" and ")} on site ${
      process.env.NETLIFY_SITE_ID}, and read it back.`);

    // The functions read the variable as of their deploy.
    const hook = process.env.PICKUP_SCHEDULE_HOOK;

    if (!hook) {
      return out("Now deploy for it to take effect: Netlify, Deploys, " +
        "Trigger deploy (or PICKUP_SCHEDULE_HOOK, a build hook, in the " +
        "env file does it from here).");
    }

    const res = await fetch(hook, { method: "POST" });

    if (!res.ok) throw new Error(`The build hook answered ${res.status}.`);

    return out("Deploy started. It fails, and the last good one stays " +
      "live, if the schedule doesn't pass there either.");
  }
  case "passes issue": {
    const email = typeof flags.email === "string" ? flags.email : null;
    const standing = flags.standing === true;
    const waiveFee = flags["waive-fee"] === true;
    let days = passes.PASS_DAYS;

    if (flags.days !== undefined) days = Number(flags.days);
    else if (standing) days = null;

    const pass = await passes.issuePass(stores, {
      email, days, standing, waiveFee,
      note: typeof flags.note === "string" ? flags.note : "",
    });
    const what = waiveFee ? "the delivery minimum and fee"
      : "the delivery minimum";
    const which = standing ? "every order" : "one order";
    const until = pass.expiresAt ? `, until ${pass.expiresAt.slice(0, 10)}`
      : ", until revoked";

    return out(`${pass.code}  lifts ${what} on ${which}${
      pass.email ? ` from ${pass.email}` : ""}${until}.`);
  }
  case "passes list": {
    const list = await passes.listPasses(stores);

    for (const p of list) {
      out(`${p.code}  ${passes.passState(p)}  ${p.email || "any email"}${
        p.note ? `  ${p.note}` : ""}`);
    }
    if (!list.length) out("No passes.");

    return undefined;
  }
  case "passes revoke":
    return out(`Revoked ${(await passes.revokePass(stores, rest[0])).code}.`);
  case "jobs run":
    return out(await runJobs(stores));
  case "jobs square": {
    const apply = !!flags.apply;
    const paused = await square.deletionsPaused(stores);

    // The kill switch stops a cancel asked for here too (#241).
    if (apply && paused) {
      throw new Error("The Square deletion kill switch is set: the " +
        "cleanups are paused, so --apply cancels nothing. Run bin/nff " +
        "square deletions status to see why.");
    }

    const found = await sweepSquareOrders(stores, { cancel: apply });

    if (!found) return out("Square is not configured here.");
    for (const o of found) {
      out(`${o.createdAt.slice(0, 16)}  ${o.orderId}  ${o.squareOrderId}  ${
        dollars(o.total)}  ${o.error ? `error: ${o.error}`
        : o.cancelled ? "cancelled" : o.later ? "next run"
          : apply ? "left (paid or closed)" : "open"}`);
    }

    return out(`${found.length} left open.${apply ? ""
      : paused ? " This is only a report: the Square deletion kill " +
        "switch is set, so the daily sweep cancels nothing."
        : " This is only a report; --apply cancels them."}`);
  }
  case "jobs customers": {
    const apply = !!flags.apply;
    const paused = await square.deletionsPaused(stores);

    // The kill switch stops a delete asked for here too (#236).
    if (apply && paused) {
      throw new Error("The Square deletion kill switch is set: the " +
        "cleanups are paused, so --apply deletes nothing. Run bin/nff " +
        "square deletions status to see why.");
    }

    const found = await sweepMadeCustomers(stores, { remove: apply });

    if (!found) return out("Square is not configured here.");
    for (const c of found) {
      out(`${c.at.slice(0, 16)}  ${c.orderId}  ${c.customerId}  ${
        c.error ? `error: ${c.error}` : c.deleted ? "deleted"
          : c.later ? "next run" : "unpaid"}`);
    }

    return out(`${found.length} profiles made for payments that never ` +
      `went through.${apply ? ""
        : paused ? " This is only a report: the Square deletion kill " +
          "switch is set, so the daily sweep deletes nothing."
          : " This is only a report; --apply deletes them."}`);
  }
  case "jobs history": {
    const n = Number(flags.n) || 20;
    const runs = await runsSince(stores, new Date(0));

    for (const r of runs.slice(0, n)) {
      const bad = (r.errors || []).length + (r.invariants || []).length;

      const c = r.counts || {};

      out(`${r.at.slice(0, 16)}  ${bad ? "FAIL" : "ok  "}  reminded ${
        c.deliveryReminded ?? 0}  closed ${c.closed ?? 0}  synced ${
        c.squareSynced ?? 0}  told ${c.missedTold ?? 0}  held ${
        c.holdsExpired ?? 0}  pickups ${
        c.pickupsToConfirm ?? 0}  swept ${
        r.checkoutsSwept ?? 0}  signins ${r.authSwept ?? 0}  scrubbed ${
        c.scrubbed ?? 0}  open ${c.squareOpen ?? 0}  profiles ${
        c.customersMade ?? 0}${
        (r.errors || []).map((e) => `\n    error ${e.id || "-"}: ${e.error}`)
          .join("")}${(r.invariants || []).map((v) =>
        `\n    invariant ${v.rule}: ${v.id}`).join("")}`);
    }
    if (!runs.length) out("No runs recorded.");

    return undefined;
  }
  case "health":
    return out(await snapshot(stores));
  case "alert test": {
    const r = await alertTest(stores);
    const host = new URL(process.env.HEALTHCHECKS_ALERT_URL).host;

    out(`Alert test (alert.test) on ${process.env.SITE_CONTEXT}.`);
    if (r.delivered) {
      out(`  Email: sent to ${r.to.join(", ")} (MAIL_DRIVER ${r.driver}).`);
    } else if (r.status === "sent") {
      out(`  Email: logged only, not sent (MAIL_DRIVER ${r.driver}; ` +
        "resend or outbox delivers).");
    } else {
      out(`  Email: NOT sent: ${r.mailError || "no recipients"}.`);
    }
    out(`  Phone: /fail ${r.failed ? "accepted" : "NOT accepted"} by ${
      host}; re-arm ${r.rearmed ? "accepted" : "NOT accepted"}.`);
    out(r.failed && r.rearmed
      ? "  A down push, then an up push, should reach the phone within a " +
        "minute."
      : "  The phone will not hear of this one.");
    if (!r.delivered || !r.failed || !r.rearmed) process.exitCode = 1;

    return undefined;
  }
  case "mail test-dev": {
    const r = await admin.devMailTest(stores);
    const where = process.env.SITE_CONTEXT || "this context";

    out(`Developer mail test on ${where} (MAIL_DRIVER ${r.driver}).`);
    if (r.delivered) {
      out(`  Sent to ${r.variable} (${r.count} address${
        r.count === 1 ? "" : "es"}). Check the inbox.`);
    } else if (!r.error) {
      out(`  Logged only, not sent: MAIL_DRIVER ${r.driver} writes the ` +
        "message where nobody reads it (resend or outbox delivers).");
    } else {
      out(`  FAILED: ${r.variable} ${r.error}.`);
    }
    if (!r.delivered) process.exitCode = 1;

    return undefined;
  }
  case "square deletions": {
    const what = rest[0] || "status";

    if (what === "pause" || what === "resume") {
      const r = await square.setPause(stores, what === "pause", {
        by: "bin/nff",
      });

      out(r.changed
        ? `Square deletions are now ${r.paused ? "PAUSED" : "running"} on ${
          process.env.SITE_CONTEXT}. The next jobs run reads it.`
        : `Square deletions were already ${
          r.paused ? "paused" : "running"}.`);
    } else if (what !== "status") {
      throw new Error("Say status, pause or resume.");
    }

    const flag = await square.readPause(stores);
    const env = square.envPaused();

    return out(`Flag: ${flag.unreadable ? "unreadable, so paused"
      : flag.paused ? `paused (since ${flag.at} by ${flag.by})`
        : "not set"}. ${square.KILL_SWITCH} in this env file: ${
      env ? "set" : "unset"} (Netlify's takes effect at a deploy). ` +
      `Cleanups ${flag.paused || env ? "PAUSED" : "run"}.`);
  }
  case "maintenance status": {
    const s = await maintenance.readState(stores);

    return out(`Maintenance is ${s.on ? "ON" : "off"} on ${
      process.env.SITE_CONTEXT}${s.at ? ` (since ${s.at} by ${s.by})` : ""}.`
      + `${process.env.MAINTENANCE_SECRET ? "" : " MAINTENANCE_SECRET is not"
        + " set, so there are no phone links."}`);
  }
  case "maintenance on":
  case "maintenance off": {
    const on = action === "on";
    const r = await maintenance.setState(stores, on, { by: "bin/nff" });

    return out(r.changed
      ? `Maintenance is now ${on ? "ON" : "off"} on ${
        process.env.SITE_CONTEXT}. The farm was emailed.`
      : `Maintenance was already ${on ? "ON" : "off"}.`);
  }
  case "maintenance links": {
    const s = await maintenance.readState(stores);
    const l = maintenance.links(process.env, s.epoch);

    if (!l) throw new Error("MAINTENANCE_SECRET is not set in this env file.");
    out(`Open on the phone; each asks before it acts.\nON:  ${l.on}\nOFF: ${
      l.off}`);

    return undefined;
  }
  case "maintenance rotate": {
    const s = await maintenance.rotate(stores);

    return out(`Every earlier link is dead (epoch ${s.epoch}). Run ` +
      "`maintenance links` for the new ones.");
  }
  case "sessions end-all": {
    const where = process.env.SITE_CONTEXT || "this";
    const { count } = await admin.endAllSessions(stores);

    out(`${count} session${count === 1 ? "" : "s"} on ${where}.`);
    if (!flags.yes) {
      const answer = await askLine(
        `End every session on ${where}? Type "end all" to go ahead: `
      );

      if (answer.trim() !== "end all") return out("Nothing changed.");
    }

    const r = await admin.endAllSessions(stores, { apply: true });

    return out(`Ended ${r.count}. ${r.notified
      ? "The developer was emailed."
      : "No DEV_NOTIFICATIONS_EMAIL, so no email."}`);
  }
  case "errors show":
    return errorsShow(rest[0]);
  default:
    console.error(USAGE);
    process.exit(1);
  }

  return undefined;
};

try {
  await run();
} catch (error) {
  console.error(redact(error.message, held));
  process.exit(1);
}
