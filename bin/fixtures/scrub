#!/usr/bin/env node
// Turns the raw responses bin/fixtures/record keeps in
// .ignored/fixtures-raw/ into the fixtures the tests replay, in
// test/fixtures/<service>/<name>.json (#471). Run it again after every
// recording: it rewrites the same names and touches nothing else.
//
//   bin/fixtures/scrub            scrub, and list what to look at
//   bin/fixtures/scrub --strict   the same, but exit 1 if anything is
//                                 listed
//
// The shape stays the vendor's. What changes: ids, idempotency keys,
// tokens, emails, phone numbers, names and addresses become placeholders
// (ORDER_ID_1, customer@example.com). The same value gets the same
// placeholder in every file, so a payment id in one fixture is still the
// payment id in the next. A value is judged by its key, not its look, so
// a rule here must name any new kind of field; whatever no rule covers
// and does not look harmless (an enum, a timestamp, a number, ours) is
// listed as "to review" by path, never by value, in the request as well
// as the response: a PayPal webhook's request body is the whole event.

import {
  existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync,
} from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

// Values the tests and the vendors both use, never replaced.
const KEEP = new Set([
  "CASH", "EXTERNAL", "USD", "US", "delivered@resend.dev",
  "onboarding@resend.dev",
]);
const keepValue = (v) => KEEP.has(v) || v.startsWith("cnon:");

// Keys whose value is always this, whatever it was.
const FIXED = {
  "given_name": "Given",
  "family_name": "Family",
  "display_name": "Display Name",
  nickname: "Nickname",
  "company_name": "Company Name",
  "business_name": "Business Name",
  "address_line_1": "ADDRESS_LINE_1",
  "address_line_2": "ADDRESS_LINE_2",
  "address_line_3": "ADDRESS_LINE_3",
  locality: "LOCALITY",
  sublocality: "SUBLOCALITY",
  "administrative_district_level_1": "ST",
  "administrative_district_level_2": "DISTRICT_2",
  "postal_code": "00000",
  // PayPal's and Venmo's payer, in a webhook event as much as in an
  // answer (#708).
  surname: "Surname",
  "full_name": "Full Name",
  "user_name": "venmo-user",
  "admin_area_1": "ST",
  "admin_area_2": "LOCALITY",
  "national_number": "5555550100",
  "birth_date": "1970-01-01",
  // Where a webhook delivery's signing cert lives: its id is PayPal's.
  "paypal-cert-url": "https://api.paypal.com/v1/notifications/certs/CERT-ID",
  "cert_url": "https://api.paypal.com/v1/notifications/certs/CERT-ID",
  "website_url": "https://example.com",
  "twitter_username": "twitter",
  "instagram_username": "instagram",
  "facebook_url": "https://example.com/facebook",
  "logo_url": "https://example.com/logo.png",
  "full_format_logo_url": "https://example.com/logo.png",
  "pos_background_url": "https://example.com/background.png",
  "statement_description_identifier": "STATEMENT",
  from: "Farm <farm@example.com>",
  "reply_to": "reply@example.com",
  // Free text the farm types at a refund, which may name a person (#730).
  "note_to_payer": "Note to payer",
};

// Keys whose text is also taken out of every other string that quotes it.
const QUOTED = new Set(["note_to_payer"]);
// Keys whose value is a path or a link, never free text a note could sit
// in (#730).
const NOT_TEXT = new Set(["path", "href"]);

// Our name, which PayPal echoes as brand_name and in an order's
// description (lib/paypal.mjs).
const COMPANY = JSON.parse(readFileSync(
  new URL("../../data/company.json", import.meta.url), "utf8")).name;

// Keys that hold a secret or a one-off string: each distinct value gets
// the next number of its kind.
const NUMBERED = [
  [/^idempotency[-_]key$/i, "IDEMPOTENCY_KEY"],
  [/^fingerprint$/, "FINGERPRINT"],
  [/^receipt_number$/, "RECEIPT_NUMBER"],
  [/^cursor$/, "CURSOR"],
  [/(^|_)(access_|refresh_)?token$/, "TOKEN"],
  [/^(secret|password|signature|api_key)$/, "SECRET"],
  // A PayPal delivery's signature: the header and the verify call's field.
  [/transmission[-_]sig$/, "SIGNATURE"],
];

// Keys that name a person: besides being fixed, each value is taken out
// of any other string that quotes it as a whole word (a note, a message).
const PERSONAL = new Set([
  "given_name", "family_name", "surname", "full_name", "display_name",
  "nickname", "user_name",
]);

// A location is James's business: only these of its fields survive.
const LOCATION_KEEP = new Set([
  "status", "type", "country", "currency", "language_code", "timezone",
  "capabilities", "created_at", "mcc", "business_hours",
]);

// Strings that are harmless wherever they sit, for the review list.
const ENUM = /^[A-Z][A-Z0-9_]*$/;
const PLACEHOLDER = /^[A-Z][A-Z0-9_]*_\d+$/;
const TIME = /^\d{4}-\d{2}-\d{2}([T ]|$)/;
const NUMBER = /^-?\d+(\.\d+)?$/;
const SQUARE_URL =
  /^https:\/\/([a-z0-9-]+\.)*(squareup|squareupsandbox)\.com\//;
// PayPal's own hosts in a HATEOAS link's href: its API, the approve page
// and its docs (#730).
const PAYPAL_API = /^api(-m)?\.(sandbox\.)?paypal\.com$/;
const PAYPAL_WWW = /^www\.(sandbox\.)?paypal\.com$/;
const PAYPAL_DOCS = "developer.paypal.com";
// The words of PayPal's API routes; any other word in an API link's path
// is listed.
const ROUTE_WORDS = new Set([
  "v1", "v2", "v3", "checkout", "orders", "payments", "captures",
  "authorizations", "refunds", "capture", "authorize", "reauthorize",
  "void", "refund", "confirm-payment-source", "track", "trackers",
  "notifications", "webhooks", "webhooks-events", "webhook-event-types",
  "resend", "certs", "verify-webhook-signature", "simulate-event",
  "reporting", "transactions", "balances", "vault", "payment-tokens",
  "setup-tokens", "invoicing", "invoices", "billing", "subscriptions",
  "plans", "disputes", "identity", "oauth2", "token", "userinfo",
]);
// The query keys an API link may carry, with what each value may be.
const LINK_QUERY = new Map([
  ["token", PLACEHOLDER], ["page", NUMBER], ["page_size", NUMBER],
  ["total_required", /^(true|false)$/], ["fields", /^[a-z_]+(,[a-z_]+)*$/],
]);
const urlOf = (href) => {
  try {
    const url = new URL(href);

    return url.protocol === "https:" && !url.username && !url.password
      && !url.port ? url : null;
  } catch {
    return null;
  }
};
// An href whose ids the first pass swaps: one on PayPal's API or www host.
const paypalHref = (href) => {
  const url = urlOf(href);

  return Boolean(url && (PAYPAL_API.test(url.hostname)
    || PAYPAL_WWW.test(url.hostname)));
};
// Whether a scrubbed href is exactly one of PayPal's link forms: an API
// route with every id a placeholder, the approve link with a placeholder
// token, or a doc link. No fragment but a doc link's error name.
const paypalLink = (href) => {
  const url = urlOf(href);

  if (!url) return false;
  const query = [...url.searchParams];
  const fragment = href.includes("#");

  if (PAYPAL_API.test(url.hostname)) {
    return !fragment && url.pathname.split("/").filter(Boolean)
      .every((word) => ROUTE_WORDS.has(word) || PLACEHOLDER.test(word))
      && query.every(([key, value]) => LINK_QUERY.has(key)
        && LINK_QUERY.get(key).test(value));
  }
  if (PAYPAL_WWW.test(url.hostname)) {
    return !fragment && url.pathname === "/checkoutnow"
      && query.length === 1 && query[0][0] === "token"
      && PLACEHOLDER.test(query[0][1]);
  }

  return url.hostname === PAYPAL_DOCS && !href.includes("?")
    && /^\/(docs|api)\//.test(url.pathname)
    && (!url.hash || /^#[A-Za-z0-9_-]+$/.test(url.hash));
};
// Which PayPal a record talked to, from the hosts it names: links on
// api-m, a webhook's signing cert on api.
const PAYPAL_LIVE = /https:\/\/api(-m)?\.paypal\.com\//;
const PAYPAL_SANDBOX = /https:\/\/api(-m)?\.sandbox\.paypal\.com\//;
const SAFE_KEYS = new Set([
  "currency", "country", "type", "status", "state", "code", "category",
  "source_type", "entry_method", "card_brand", "card_type", "prepaid_type",
  "cvv_status", "avs_status", "statement_description", "scope",
  "calculation_phase", "quantity", "item_type", "channel", "field",
  "detail", "message", "name", "sku", "method", "path", "reference_id",
  "note", "source", "order_flow", "site_version", "language_code",
  "timezone", "object", "statusCode", "version", "owner", "action",
  "last_4", "reason", "exp_month", "exp_year", "bin", "buyer_email_address",
  "category_name", "unit", "schedule_type", "mcc", "Content-Type",
  "Square-Version", "X-Fixture", "subject", "text", "html", "filename",
  "content", "content_type", "to", "service", "environment", "recorded",
  "by", "squareVersion", "payment_ids", "kind", "content-type",
  "paypal-auth-algo", "auth_algo", "event_type", "resource_type",
]);

// Paths whose text is PayPal's or ours, by the whole path from "request"
// or "response" -> whether the value is safe there. PayPal's fixed text
// is safe only where PayPal puts it (#730).
const escaped = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const companyOrder = new RegExp(
  `^${escaped(COMPANY)} order [A-Z][A-Z0-9_]*_\\d+$`);
// The same form before its id is swapped -> [, id].
const companyOrderRaw = new RegExp(`^${escaped(COMPANY)} order (\\S+)$`);
const SAFE_PATHS = [
  [/(^|\.)brand_name$/, (value) => value === COMPANY],
  // A link's relation, from PayPal's vocabulary.
  [/(^|\.)links\.rel$/, (value) => /^[a-z_-]+$/.test(value)],
  // A webhook event's summary, at the event's top level.
  [/^request\.body\.(webhook_event\.)?summary$/, () => true],
  // An error answer's details.
  [/^(response|request\.body)\.details\.description$/, () => true],
  // Ours, once its order id is swapped: a description, or a note that is
  // one.
  [/(^|\.)(purchase_units\.description|note_to_payer)$/,
    (value) => companyOrder.test(value)],
];
const safeAt = (keys, value) => {
  const path = keys.join(".");

  return SAFE_PATHS.some(([at, ok]) => at.test(path) && ok(value));
};

// What a PayPal resource is, from its event's resource_type.
const RESOURCE = { "checkout-order": "ORDER", capture: "CAPTURE",
  refund: "REFUND" };

const singular = (key) => key.replace(/s$/, "");
const upper = (key) => key.toUpperCase();

// What an id-bearing key stands for: [kind, strong]. A key that names
// its thing (payment_id) outvotes one that is only "id" under a parent
// (a tender's id is the payment's).
const idKind = (key, parent, top) => {
  if (key === "reference_id" || key === "source_id") return null;
  // A header's id too (paypal-transmission-id, paypal-request-id).
  if (/[-_]ids?$/i.test(key)) {
    return [upper(key.replace(/s$/, "").replace(/-/g, "_")), true];
  }
  if (key === "id") return [`${upper(singular(parent || top))}_ID`, false];
  if (key === "uid" || key.endsWith("_uid")) {
    return [`${upper(singular(parent || top))}_UID`, false];
  }

  return null;
};

const EMAIL = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g;

// A request's path can be the only place an id sits: a refund recorded
// alone, a GET of an order, an EC- token in a query string. Its words,
// split at / ? & = # (a query's keys never count), are judged like a
// file name's, and an id is named by the word before it (captures gives
// CAPTURE_ID, PayerID= gives PAYER_ID, token= gives TOKEN):
// - a route word that is neither lowercase (v2, checkout, a short
//   number) nor a placeholder is an id, all digits or all letters too;
// - a query value under an id key (id, token or Token, PayerID,
//   order_id, orderId) is always one;
// - any other query value is one only with a letter and a digit and
//   not a time: an enum (COMPLETED), a time or a number is a query's
//   ordinary value, and swapping it would rewrite every response that
//   holds it.
// -> [[word, kind]].
const PATH_WORD = /^([a-z]+\d?([-_.][a-z]+\d?)*|\d{1,3})$/;
// Any case for a whole word (id, Token, ORDER_ID), but camelCase only as
// Id or ID, so paid and valid stay plain words.
const isIdKey = (key) => /(^|_)(token|id)$/i.test(key) || /I[dD]$/.test(key);
const decoded = (word) => {
  try {
    return decodeURIComponent(word);
  } catch {
    return word;
  }
};
const idLike = (word) => /[A-Za-z]/.test(word) && /\d/.test(word)
  && !TIME.test(decoded(word));
// -> { route: [word], query: [[key, value]] }, empty words left out.
const pathParts = (path) => {
  const [route, query = ""] = String(path || "").split(/\?(.*)/s);

  return {
    route: route.split(/[/#]+/).filter(Boolean),
    query: query.split(/[&#]+/).filter(Boolean)
      .map((pair) => pair.split(/=(.*)/s).slice(0, 2)),
  };
};
const pathIds = (path) => {
  const found = [];
  let before = "";
  const { route, query } = pathParts(path);
  // [word, role]: a route word, a query key, an id key's value, or
  // another query value.
  const words = [
    ...route.map((word) => [word, "route"]),
    ...query.flatMap(([key, value = ""]) => [
      [key, "key"], [value, isIdKey(key) ? "id" : "value"],
    ]),
  ].filter(([word]) => word);
  const isId = (word, role) => {
    if (role === "key" || PLACEHOLDER.test(word) || keepValue(word)) {
      return false;
    }
    if (role === "id") return true;

    return !PATH_WORD.test(word) && (role === "route" || idLike(word));
  };

  for (const [word, role] of words) {
    if (!isId(word, role)) {
      before = word;
      continue;
    }
    const snake = before.replace(/([a-z])([A-Z])/g, "$1_$2")
      .replace(/[^A-Za-z0-9]+/g, "_").toUpperCase();
    let kind = "ID";

    if (/(^|_)TOKEN$/.test(snake)) kind = "TOKEN";
    else if (/(^|_)ID$/.test(snake)) kind = snake;
    else if (/^[A-Z]/.test(snake) && !PLACEHOLDER.test(before)) {
      kind = `${snake.replace(/S$/, "")}_ID`;
    }
    found.push([word, kind]);
    before = "";
  }

  return found;
};

// Whether a scrubbed path still holds something to look at: a word
// pathIds takes for an id (one too short to swap), or a query value that
// is not lowercase, an enum, a time, a number or a kept value (each item
// of a comma list judged alone).
const plainValue = (value) => PATH_WORD.test(value) || ENUM.test(value)
  || TIME.test(decoded(value)) || NUMBER.test(value) || keepValue(value);
const pathLeft = (path) => pathIds(path).length > 0
  || pathParts(path).query.some(([, value = ""]) => value
    && !(plainValue(value) || decoded(value).split(",")
      .every((item) => !item || plainValue(item))));

// A URL's path and query, so its host is not taken for an id.
const urlPath = (url) => {
  try {
    const { pathname, search } = new URL(url);

    return `${pathname}${search}`;
  } catch {
    return url;
  }
};

// What a PayPal answer's top-level id is, from the request's path: the
// thing the path's last id names (orders/X/capture answers with the
// order), a refund for a refund, or else the path's last word (POST
// /v2/checkout/orders makes an order).
const topKind = (path) => {
  const { route } = pathParts(path);
  const last = route[route.length - 1] || "";

  if (last === "refund") return "REFUND_ID";
  const ids = pathIds(`/${route.join("/")}`);

  if (ids.length) return ids[ids.length - 1][1];
  if (!/^[a-z][a-z-]*$/.test(last)) return null;

  return `${upper(singular(last)).replace(/-/g, "_")}_ID`;
};

// Walks every leaf string of a value: visit(value, key, keys) where
// keys is the path of object keys (array positions left out).
const walk = (node, visit, keys = []) => {
  if (Array.isArray(node)) {
    return node.map((item) => walk(item, visit, keys));
  }
  if (node && typeof node === "object") {
    return Object.fromEntries(Object.entries(node)
      .map(([key, value]) => [key, walk(value, visit, [...keys, key])]));
  }

  return visit(node, keys);
};

const leafKey = (keys) => keys[keys.length - 1] || "";

// A recorder's name (netlify/functions/lib/recorder.mjs) slugs the raw
// path, so a PayPal order or capture id would sit in a public file
// name. Such a name is rebuilt from its time, the method, the scrubbed
// path and its random suffix, and a path word pathIds takes for an id
// becomes "id" (other words are kept, in lowercase, so page=2 reads
// "page-2", not "page-id"). bin/fixtures/record's own
// names are chosen by hand and kept.
const RECORDER_NAME = /^(paypal-\d{8}T\d+Z)-[a-z]+-.*-([0-9a-f]{6})$/;
const fileName = (name, request) => {
  const parts = RECORDER_NAME.exec(name || "");

  if (!parts) return name;
  let path = String((request && request.path) || "");

  for (const [word] of pathIds(path)) path = path.split(word).join("/id/");
  const words = path.split(/[^A-Za-z0-9_]+/).filter(Boolean)
    .map((word) => word.toLowerCase().replace(/_/g, "-"));
  const method = String((request && request.method) || "").toLowerCase();

  return [parts[1], method, ...words, parts[2]].filter(Boolean).join("-");
};

// -> the envelopes' scrubbed fixtures, [{ service, name, json, review }].
// Each file: { name, service, status, request, response, recorded }.
export const scrubAll = (files) => {
  const votes = new Map();
  const vote = (value, kind, strong) => {
    const had = votes.get(value);

    if (!had || (strong && !had.strong)) votes.set(value, { kind, strong });
  };
  const own = (file) => ({ request: file.request, response: file.response });
  const people = new Set();
  const quotes = new Map();
  // Notes of the form "<company> order <id>" -> [id, fixed text].
  const forms = new Map();
  // Too short to swap safely in every other string: left for the review
  // list instead.
  const votePath = (path) => {
    for (const [word, kind] of pathIds(path)) {
      if (word.length >= 6) vote(word, kind, false);
    }
  };

  // First pass: what is an id, and what kind.
  for (const file of files) {
    const top = file.service === "resend" ? "email" : "";
    const paypal = file.service === "paypal";
    const body = (file.request && file.request.body) || {};
    // A webhook delivery's body is the event; the verify call carries it.
    const event = body.event_type ? body : body.webhook_event;
    const resource = event && RESOURCE[event.resource_type];
    const answer = paypal && topKind(file.request && file.request.path);
    // Keys[0] is "request" or "response": a parent starts at keys[1].

    walk(own(file), (value, keys) => {
      if (typeof value !== "string" || !value || keepValue(value)) {
        return value;
      }
      const key = leafKey(keys);
      const parent = keys.length > 2 ? keys[keys.length - 2] : undefined;
      let found = idKind(key, parent, top || "id");

      // One name per PayPal thing, whichever key shows it first (#730).
      if (found && key === "id" && paypal) {
        if (keys.length === 2 && answer) found = [answer, false];
        else if (keys.join(".") === "request.body.id" && body.event_type) {
          found = ["WEBHOOK_EVENT_ID", false];
        } else if (parent === "resource" && resource) {
          found = [`${resource}_ID`, false];
        }
      }
      if (found) vote(value, found[0], found[1]);
      if (keys.join(".") === "request.path") votePath(value);
      if (key === "href" && paypalHref(value)) votePath(urlPath(value));
      if (PERSONAL.has(key) && value.length >= 3) people.add(value);
      // A note that is our description form keeps it (#730).
      const form = QUOTED.has(key) && companyOrderRaw.exec(value);

      if (form) forms.set(value, [form[1], FIXED[key]]);
      else if (QUOTED.has(key) && value.trim().length >= 3) {
        quotes.set(value, FIXED[key]);
      }
      for (const [pattern, kind] of NUMBERED) {
        if (pattern.test(key)) vote(value, kind, true);
      }

      return value;
    });
    // An array of ids (payment_ids, refund_ids) is walked leaf by leaf
    // with its own key, which idKind reads.
  }

  // A form note whose id no record names is free text after all.
  const kept = new Set();

  for (const [value, [id, to]] of forms) {
    if (votes.has(id)) kept.add(value);
    else quotes.set(value, to);
  }

  // Numbering: in the order the values first appear.
  const names = new Map();
  const counts = {};
  const nameOf = (value) => {
    if (!names.has(value)) {
      const { kind } = votes.get(value);

      counts[kind] = (counts[kind] || 0) + 1;
      names.set(value, `${kind}_${counts[kind]}`);
    }

    return names.get(value);
  };
  const emails = new Map();
  const phones = new Map();
  const emailOf = (value) => {
    if (keepValue(value)) return value;
    if (!emails.has(value)) {
      const n = emails.size + 1;

      emails.set(value, n === 1 ? "customer@example.com"
        : `customer-${n}@example.com`);
    }

    return emails.get(value);
  };
  const phoneOf = (value) => {
    if (!phones.has(value)) {
      const n = String(100 + phones.size).padStart(4, "0");

      phones.set(value, `+1555555${n}`);
    }

    return phones.get(value);
  };

  // Second pass: replace, in the same order as the first.
  const replaced = files.map((file) => {
    const scrubbed = walk(own(file), (value, keys) => {
      if (typeof value === "number") {
        const key = leafKey(keys);

        return key === "latitude" || key === "longitude" ? 0 : value;
      }
      if (typeof value !== "string" || !value || keepValue(value)) {
        return value;
      }

      const key = leafKey(keys);
      const inLocation = keys[0] === "response" && keys.includes("locations");

      if (inLocation) {
        const field = keys[keys.indexOf("locations") + 1];

        if (!LOCATION_KEEP.has(field) && !/_id$|^id$/.test(field)) {
          return FIXED[key] || "REDACTED";
        }
      }
      if (key in FIXED && !(QUOTED.has(key) && kept.has(value))) {
        return FIXED[key];
      }
      if (votes.has(value)) return nameOf(value);
      if (/email/.test(key) && !/^(from|reply_to)$/.test(key)) {
        return emailOf(value);
      }
      if (key === "phone_number") return phoneOf(value);

      return value;
    });

    return { file, scrubbed };
  });

  // Every id has its number before any text is searched for it.
  for (const value of votes.keys()) nameOf(value);

  // Whatever else carries a known id or email (a path, a URL, a message
  // that quotes one): the same replacement, longest value first.
  const swaps = [
    ...[...names].map(([from, to]) => [from, to]),
    ...[...emails].map(([from, to]) => [from, to]),
  ].sort((a, b) => b[0].length - a[0].length);
  const quoted = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  // Any case: a handle or a shout quotes a name in its own case.
  const named = [...people].sort((a, b) => b.length - a.length)
    .map((value) => new RegExp(`(?<!\\w)${quoted(value)}(?!\\w)`, "gi"));
  // A note is taken out whole, before an id inside it is swapped, with
  // any run of whitespace between its words, as PayPal may echo it.
  const notes = [...quotes].sort((a, b) => b[0].length - a[0].length)
    .map(([value, to]) => [new RegExp(`(?<!\\w)${value.trim().split(/\s+/)
      .map(quoted).join("\\s+")}(?!\\w)`, "gi"), to, value]);
  // Free text only: never a path or a link, and never a one-word value
  // (an enum such as resource_type "refund") unless it is the note itself.
  const freeText = (value, key) => !NOT_TEXT.has(key) && /\s/.test(value);
  // Every word of four or more letters in a note, for the review list.
  const words = [...new Set([...quotes.keys()].flatMap((value) => value
    .toLowerCase().match(/[a-z]{4,}/g) || []))];
  const noteWords = words.length ? new RegExp(
    `(?<![A-Za-z])(${words.join("|")})(?![A-Za-z])`, "i") : null;
  const mop = (text, key) => {
    let out = text;

    for (const [pattern, to, value] of notes) {
      if (out === value) out = to;
      else if (freeText(out, key)) out = out.replace(pattern, to);
    }
    for (const [from, to] of swaps) out = out.split(from).join(to);
    for (const pattern of named) out = out.replace(pattern, "NAME");

    return out.replace(EMAIL, (m) => (m.endsWith("@example.com")
      ? m : emailOf(m)));
  };

  // A PayPal record's environment, from its own hosts or else the run's.
  const hostOf = (file) => {
    if (file.service !== "paypal") return null;
    const text = JSON.stringify(own(file));
    const live = PAYPAL_LIVE.test(text);
    const sandbox = PAYPAL_SANDBOX.test(text);

    if (live === sandbox) return null;

    return live ? "production" : "sandbox";
  };
  const hosts = new Set(files.map(hostOf).filter(Boolean));
  const environment = (file) => {
    if (file.service === "square") return "sandbox";
    if (file.service !== "paypal") return "test address";

    return hostOf(file) || (hosts.size === 1 ? [...hosts][0] : "unknown");
  };

  return replaced.map(({ file, scrubbed }) => {
    const clean = walk(scrubbed, (value, keys) => (
      typeof value === "string" && !keepValue(value)
        && !PLACEHOLDER.test(value) ? mop(value, leafKey(keys)) : value));
    const version = file.request.headers
      && file.request.headers["Square-Version"];

    return {
      service: file.service,
      name: fileName(file.name, clean.request),
      json: {
        _source: {
          service: file.service,
          environment: environment(file),
          recorded: file.recorded,
          ...(version ? { squareVersion: version } : {}),
          by: "bin/fixtures/record, scrubbed by bin/fixtures/scrub",
        },
        status: file.status,
        request: clean.request,
        response: clean.response,
      },
      // A webhook's request is PayPal's event, so it is looked at too.
      // Response paths stay bare; request paths say so.
      review: [
        ...review(clean.response, "response", noteWords),
        ...review(clean.request, "request", noteWords)
          .map((path) => `request.${path}`),
        // Path is a safe key, so a word the path rule missed is named.
        ...(pathLeft(clean.request && clean.request.path)
          ? ["request.path"] : []),
      ],
    };
  });
};

// Whether a string in a fixture is one the scrubber put there (a
// placeholder, a replaced name, a made-up email or phone), so a test
// comparing what our code sends with a recorded request treats it as
// "any value".
export const isPlaceholder = (value) => typeof value === "string"
  && (PLACEHOLDER.test(value) || Object.values(FIXED).includes(value)
    || /^customer(-\d+)?@example\.com$/.test(value)
    || /^\+1555555\d{4}$/.test(value));

// Paths of a request's or a response's strings that no rule covered and
// that do not look harmless. Paths only, so the report leaks nothing.
// root is "request" or "response"; noteWords, if any, matches a word of
// a note, which free text under a safe key must not hold (a note echoed
// cut short).
const review = (side, root, noteWords) => {
  const found = [];

  walk(side, (value, keys) => {
    if (typeof value !== "string" || !value) return value;
    const key = leafKey(keys);
    const echo = noteWords && !isPlaceholder(value)
      && !NOT_TEXT.has(key) && /\s/.test(value) && noteWords.test(value);

    if (!echo && (keepValue(value) || PLACEHOLDER.test(value)
      || ENUM.test(value) || TIME.test(value) || NUMBER.test(value)
      || SQUARE_URL.test(value) || SAFE_KEYS.has(key) || isPlaceholder(value)
      || safeAt([root, ...keys], value)
      // A link in one of PayPal's own forms, every id in it swapped.
      || (key === "href" && paypalLink(value)))) {
      return value;
    }
    found.push(keys.join("."));

    return value;
  });

  return found;
};

const main = async () => {
  const root = join(dirname(fileURLToPath(import.meta.url)), "..", "..");
  const raw = join(root, ".ignored", "fixtures-raw");
  const out = join(root, "test", "fixtures");
  const strict = process.argv.includes("--strict");

  if (!existsSync(raw)) {
    console.error(`No recordings in ${raw}. Run bin/fixtures/record first.`);
    process.exit(1);
  }

  // In the order they were recorded, so ORDER_ID_1 is the first order.
  const files = readdirSync(raw).filter((f) => f.endsWith(".json")).sort()
    .map((f) => {
      const path = join(raw, f);
      const envelope = JSON.parse(readFileSync(path, "utf8"));

      return {
        ...envelope,
        recorded: statSync(path).mtime.toISOString().slice(0, 10),
      };
    })
    .sort((a, b) => (a.seq ?? 1e9) - (b.seq ?? 1e9));
  const made = scrubAll(files);
  let listed = 0;

  for (const { service, name, json, review: look } of made) {
    const dir = join(out, service);

    mkdirSync(dir, { recursive: true });
    writeFileSync(join(dir, `${name}.json`),
      `${JSON.stringify(json, null, 2)}\n`);
    console.log(`  test/fixtures/${service}/${name}.json`);
    for (const path of look) {
      console.log(`    to review: ${path}`);
      listed += 1;
    }
  }
  console.log(`${made.length} fixtures written; ${listed} strings to review.`);
  if (strict && listed) process.exit(1);
};

if (import.meta.url === pathToFileURL(process.argv[1]).href) await main();
