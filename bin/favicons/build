#!/usr/bin/env bash
# Rebuild static/favicons/, the gingham egg, from bin/favicons/emblem.mjs.
# Run it from the repository root after changing the design:
#
#   bin/favicons/build
#
# Then bump the "v" in layouts/partials/head/favicon-path.html,
# site.webmanifest and browserconfig.xml so browsers fetch the new set.
# Needs Node, Inkscape and ImageMagick.
set -euo pipefail

out=static/favicons
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

emblem() {
  node bin/favicons/emblem.mjs "$@"
}

# render <size> <file> [square]: the color emblem at <size> px.
render() {
  emblem color "$1" "${3:-}" > "$tmp/emblem.svg"
  inkscape "$tmp/emblem.svg" --export-type=png \
    --export-width="$1" --export-height="$1" \
    --export-filename="$2" > /dev/null 2>&1
}

# tile <icon px> <width> <height> <file>: the emblem centred on clear,
# for the Windows tiles.
tile() {
  render "$1" "$tmp/tile.png"
  magick -size "$2x$3" xc:none "$tmp/tile.png" -gravity center \
    -composite "$4"
}

# The small sizes are the pixel-snapped design; the SVG is its 32 px
# grid, so it is crisp at both 16 and 32 px.
emblem color 32 > "$out/favicon.svg"
render 16 "$out/favicon-16x16.png"
render 32 "$out/favicon-32x32.png"
render 48 "$tmp/favicon-48.png"
magick "$out/favicon-16x16.png" "$out/favicon-32x32.png" \
  "$tmp/favicon-48.png" "$out/favicon.ico"

# The large sizes are the master design. iOS and Android shape the
# square ones themselves and fill any transparency, so those are
# opaque.
render 180 "$out/apple-touch-icon.png" square
render 192 "$out/android-chrome-192x192.png"
render 512 "$out/android-chrome-512x512.png"
render 512 "$out/maskable-512x512.png" square
for opaque in apple-touch-icon.png maskable-512x512.png; do
  magick "$out/$opaque" -background "#e3f1e8" -alpha remove -alpha off \
    "$out/$opaque"
done

# Windows tiles, at the sizes RealFaviconGenerator used.
tile 80 128 128 "$out/mstile-70x70.png"
tile 88 144 144 "$out/mstile-144x144.png"
tile 150 270 270 "$out/mstile-150x150.png"
tile 150 558 270 "$out/mstile-310x150.png"
tile 300 558 558 "$out/mstile-310x310.png"

emblem mono > "$out/safari-pinned-tab.svg"

echo "Rebuilt $out."
