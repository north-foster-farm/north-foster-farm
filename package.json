{
  "name": "north-foster-farm",
  "version": "1.0.0",
  "description": "North Foster Farm website",
  "repository": {
    "type": "git",
    "url": "https://github.com/north-foster-farm/north-foster-farm.git"
  },
  "private": true,
  "browserslist": "defaults",
  "scripts": {
    "lint": "npm run lint:scripts && npm run lint:styles",
    "lint:scripts": "eslint 'assets/scripts/**/*.{js,mjs}' 'netlify/**/*.mjs' 'test/**/*.mjs' 'e2e/**/*.mjs' 'bin/grid/*.mjs' 'bin/orphans/*.mjs' 'bin/logos/*.mjs' 'bin/facts/*.mjs' 'bin/schema/*.mjs' 'bin/fresh/*.mjs' 'bin/maps/*.mjs' 'plugins/**/*.js' bin/check-schedule.mjs bin/check-events.mjs bin/confirm.mjs bin/check-news.mjs bin/check-env.mjs bin/install-gate.mjs bin/gate.mjs bin/check-record-shape.mjs bin/dated-pages.mjs bin/check-rotation-log.mjs bin/staging-jobs-summary.mjs bin/schedule-env.mjs bin/dev-schedule.mjs bin/dev-functions.mjs 'bin/env/*.mjs' 'bin/supply/*.mjs' 'bin/svg/*.mjs' bin/gate-logo.mjs svgo.config.mjs 'bin/audit/*.mjs' 'bin/codeql/*.mjs' 'bin/e2e/*.mjs' bin/promote.mjs bin/e2e-summary.mjs 'bin/postcss/*.js' 'bin/shot/*.mjs' bin/gh-shot bin/nff *.config.js playwright.config.mjs",
    "lint:styles": "stylelint assets/styles/**/*.scss",
    "start": "bin/dev",
    "start:bind": "HUGO_BIND_TO_IP=true bin/dev",
    "start:functions": "node bin/dev-functions.mjs",
    "test": "node --import ./test/setup.mjs --test test/",
    "check": "npm run lint && npm test",
    "build:orphans": "node bin/orphans/wrap.mjs public",
    "check:grid": "node bin/grid/check.mjs public",
    "check:schema": "node bin/schema/check.mjs public",
    "check:fresh": "node bin/fresh/check.mjs public",
    "check:schedule": "node bin/check-schedule.mjs",
    "check:events": "node bin/check-events.mjs",
    "check:news": "node bin/check-news.mjs public",
    "check:staging": "node bin/check-staging.mjs public",
    "check:supply": "node bin/supply/check.mjs",
    "check:audit": "node bin/audit/check.mjs --actions .github/workflows package-lock.json",
    "check:env": "node bin/check-env.mjs",
    "check:signatures": "npm audit signatures",
    "check:record-shape": "node bin/check-record-shape.mjs",
    "check:svg": "node bin/svg/clean.mjs --check",
    "svg:clean": "node bin/svg/clean.mjs",
    "e2e": "playwright test",
    "e2e:serve": "node bin/e2e/serve.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fullhuman/postcss-purgecss": "8.0.0",
    "@playwright/test": "1.62.1",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "postcss": "8.5.25",
    "postcss-cli": "12.0.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-scss": "6.14.0",
    "svgo": "4.1.0"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.0",
    "age-encryption": "0.3.1",
    "bootstrap": "5.3.3"
  }
}
