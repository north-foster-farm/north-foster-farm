{
  "name": "north-foster-farm",
  "version": "1.0.0",
  "description": "North Foster Farm website",
  "repository": {
    "type": "git",
    "url": "https://github.com/north-foster-farm/north-foster-farm.git"
  },
  "private": true,
  "browserslist": "defaults",
  "scripts": {
    "lint": "npm run lint:code && npm run test:gates && npm run test:analysis",
    "lint:code": "npm run lint:shell && npm run lint:scripts && npm run lint:styles && npm run lint:copies && npm run lint:unused",
    "lint:shell": "node bin/lint-shell.mjs",
    "lint:scripts": "eslint --max-warnings 0 .",
    "lint:styles": "stylelint --max-warnings 0 \"**/*.{scss,css}\"",
    "lint:unused": "knip --no-progress",
    "lint:copies": "npm run lint:copies:source && npm run lint:copies:tests && npm run lint:copies:styles && npm run lint:copies:templates",
    "lint:copies:source": "jscpd -c .jscpd/source.json",
    "lint:copies:tests": "jscpd -c .jscpd/tests.json",
    "lint:copies:styles": "jscpd -c .jscpd/styles.json",
    "lint:copies:templates": "jscpd -c .jscpd/templates.json",
    "start": "bin/dev",
    "start:bind": "HUGO_BIND_TO_IP=true bin/dev",
    "start:functions": "node bin/dev-functions.mjs",
    "test": "node --import ./test/setup.mjs --test \"test/**/!(quality-analysis|quality-knip|quality-ceilings).test.mjs\"",
    "test:analysis": "node --import ./test/setup.mjs --test-concurrency=1 --test test/quality-analysis.test.mjs test/quality-knip.test.mjs test/quality-ceilings.test.mjs",
    "test:gates": "node --import ./test/setup.mjs --test test/quality-gates.gates.mjs",
    "check": "npm run check:node && npm run check:places && npm run lint:code && npm test",
    "build:orphans": "node bin/orphans/wrap.mjs public",
    "check:grid": "node bin/grid/check.mjs public",
    "check:schema": "node bin/schema/check.mjs public",
    "check:fresh": "node bin/fresh/check.mjs public",
    "check:schedule": "node bin/check-schedule.mjs",
    "check:events": "node bin/check-events.mjs",
    "check:news": "node bin/check-news.mjs public",
    "check:staging": "node bin/check-staging.mjs public",
    "check:supply": "node bin/supply/check.mjs",
    "check:audit": "node bin/audit/check.mjs --actions .github/workflows package-lock.json",
    "check:env": "node bin/check-env.mjs",
    "check:signatures": "npm audit signatures",
    "check:record-shape": "node bin/check-record-shape.mjs",
    "check:svg": "node bin/svg/clean.mjs --check",
    "svg:clean": "node bin/svg/clean.mjs",
    "e2e": "playwright test",
    "e2e:serve": "node bin/e2e/serve.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:node": "node bin/check-node.mjs",
    "check:places": "node bin/check-places.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fullhuman/postcss-purgecss": "9.1.0",
    "@playwright/test": "1.65.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "postcss": "8.5.33",
    "postcss-cli": "12.0.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-scss": "7.5.0",
    "svgo": "4.1.0"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.9",
    "age-encryption": "0.3.1",
    "bootstrap": "5.3.9",
    "qrcode-generator": "2.0.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.3",
      "onFail": "error"
    }
  }
}
