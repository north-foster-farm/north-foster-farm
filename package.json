{
  "name": "north-foster-farm",
  "version": "1.0.0",
  "description": "North Foster Farm website",
  "repository": {
    "type": "git",
    "url": "https://github.com/north-foster-farm/north-foster-farm.git"
  },
  "private": true,
  "browserslist": "defaults",
  "scripts": {
    "lint": "npm run lint:scripts && npm run lint:styles",
    "lint:scripts": "eslint 'assets/scripts/**/*.{js,mjs}' 'netlify/**/*.mjs' 'test/**/*.mjs' bin/nff *.config.js",
    "lint:styles": "stylelint assets/styles/**/*.scss",
    "start": "bin/dev",
    "start:bind": "HUGO_BIND_TO_IP=true bin/dev",
    "start:functions": "netlify dev",
    "test": "node --import ./test/setup.mjs --test test/",
    "deploy": "npm run lint && npm test && bin/prod"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fullhuman/postcss-purgecss": "6.0.0",
    "autoprefixer": "10.6.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "postcss": "8.5.25",
    "postcss-cli": "11.0.1",
    "stylelint": "16.10.0",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-scss": "6.8.1"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "bootstrap": "5.3.3"
  }
}
